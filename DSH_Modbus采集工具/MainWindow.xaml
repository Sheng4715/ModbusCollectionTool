<Window x:Class="DSH_Modbus采集工具.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DSH_Modbus采集工具"
        xmlns:ui="clr-namespace:DSH_Modbus采集工具.Ui"
        mc:Ignorable="d"
        Title="采集工具"
        Height="640" Width="1024"
        MinHeight="640" MinWidth="1024"
        Background="{DynamicResource Brush.Window.Background}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        FontSize="14"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- 枚举 → 大写名（显示格式 BIN/DEC/HEX/ASCII） -->
        <local:EnumUpperConverter x:Key="EnumUpperConverter"/>

        <!-- 布尔 → 可见性（采集任务组「展开/收起」用，见 AcquisitionTaskRowTemplate） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 标题栏按钮 -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.TitleBar.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Control.Pressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger.Fill}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger.Fill.Pressed}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            导航项外观：没有灰底轨道，选中态用叠加色 + 加粗，
            文字**水平左对齐、垂直居中**。

            外距（Margin）与高度都从模板里挪到了控件的 Style 上，模板不写死 ——
            写死了就没法在不复制模板的前提下改缩进或高矮，而复制正是样式走样的根源。

            ⚠️ 高度用 MinHeight 而不是 Height：Height 是死值，字号调大后文字会被裁；
            MinHeight 让「至少这么高、内容更高时自己撑开」。
        -->
        <ControlTemplate x:Key="NavItemTemplate" TargetType="RadioButton">
            <Border x:Name="Backplate"
                    MinHeight="{TemplateBinding MinHeight}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="4"
                    Background="Transparent"
                    HorizontalAlignment="Stretch">
                <ContentPresenter VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Backplate" Property="Background" Value="{DynamicResource Brush.Overlay.Subtle}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Backplate" Property="Background" Value="{DynamicResource Brush.Overlay.Medium}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Backplate" Property="Background" Value="{DynamicResource Brush.Overlay.Strong}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 左侧大导航：条目 40 高、字号 14 -->
        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template" Value="{StaticResource NavItemTemplate}"/>
            <EventSetter Event="Checked" Handler="Nav_Checked"/>
        </Style>

        <!-- IO 元件区分段切换（输入X / 输出Y）：灰底胶囊轨道 + 选中白底浮起 -->
        <Style x:Key="IoSegmentRadioButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBd"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBd" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBd" Property="Background" Value="{DynamicResource Brush.Control.Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 总览页视图切换：Excel 功能区式标签条（文字 + 选中项正下方的色条）。
             做法照 Excel 的「文件 / 开始 / 插入 / 绘图」那一排：
             **没有胶囊底、没有边框、没有下拉箭头** —— 未选中就是一行普通文字，
             选中项靠「加粗 + 文字正下方一条色条」区分（参考图实测：文字色选中/未选中相同，
             色条 #0F703B、高 3px、宽 39px ≈ 文字宽 40px）。

             ⚠️ **色条宽度必须等于文字宽度**：故外框 Padding 的左右给 0、色条 Margin 左右也给 0
             —— 任一处留了内边距，色条就会比文字宽出几个像素（实测宽 3px 就该修）。
             点击热区靠外框的透明背景兜住，不受影响。

             ⚠️ 与 IoSegmentRadioButton（灰底胶囊 + 白底浮起）是**两种切换语义**：那种用于
             「同一页里的并列分段」，这种用于「整页视图切换」，不要互相替代。 -->
        <Style x:Key="ViewTabRadioButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBd" Background="Transparent" CornerRadius="4" Padding="0,4">
                            <StackPanel>
                                <!-- 色条左右边界 = 文字左右边界：Margin 左右给 0（参考图 39 vs 40 px，多给 2 DIP 就宽出 3 px）。 -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- 未选中也占位（Background=Transparent），否则切换时整行高度会跳一下 -->
                                <Border x:Name="TabIndicator" Height="2" CornerRadius="1"
                                        Margin="0,3,0,0" Background="Transparent"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource Brush.Overlay.Subtle}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabIndicator" Property="Background" Value="{DynamicResource Brush.ViewTab.Indicator}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关（Windows 11 式 ToggleSwitch）
             轨道 40x20、柄 12、内缩 4（与 WinUI 的 40/20/12/4 一致）；
             轨道与柄同高同心，关＝Control.Background，开＝Accent.Fill（上面压白柄）。
             状态文字在**轨道左侧**，紧挨轨道、一次扫完，不必跨行去配对远端标签。

             ⚠️ 文字由**调用方**通过 Content 给（"开"/"关"是这一处的文案，别处可能不同），
             不要在 ControlTemplate 的触发器里 Setter Property="Content" —— 那是模板优先级，
             赢不过控件上的局部值 Content="开"，写了等于没写（实测两种状态都显示"开"）。
             要做"随状态换文案"，只能在控件侧用 Style.Triggers 绑 IsChecked，或由代码改 Content。 -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Content" Value="开"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- 文字在左、轨道在右，故 Margin 加在轨道上（外缘由调用方给） -->
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <Border x:Name="Track"
                                    Width="40" Height="20"
                                    CornerRadius="10"
                                    Margin="10,0,0,0"
                                    Background="{DynamicResource Brush.Control.Background}"
                                    VerticalAlignment="Center">
                                <Border x:Name="Knob"
                                        Width="12" Height="12"
                                        CornerRadius="6"
                                        Background="{DynamicResource Brush.Control.Selected}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="4,0,0,0"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent.Fill}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <!-- 禁用：轨道压暗，避免和"关"混淆（关是灰、禁用是更浅的灰） -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 地址表元件块（设备连接页：线圈区 / 寄存器区） -->
        <DataTemplate x:Key="AreaChipTemplate">
            <Border Background="{DynamicResource Brush.Chip.Background}" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                    CornerRadius="4" Padding="8,2" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    ToolTip="{Binding ToolTipText}">
                <TextBlock Text="{Binding Element}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}"/>
            </Border>
        </DataTemplate>

        <!-- 地址表元件行：横向排列，不换行 -->
        <Style x:Key="AreaItemsControlStyle" TargetType="ItemsControl">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ItemTemplate" Value="{StaticResource AreaChipTemplate}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IO 分页按钮（卡片右上角 < >） -->
        <Style x:Key="IoPagerButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PagerBd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PagerBd" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PagerBd" Property="Background" Value="{DynamicResource Brush.Control.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled.Soft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            通用文字按钮（浅灰实底胶囊）：设备监控卡片的「导入 IO 表」、
            设备连接的「刷新 / 连接」都用它。
            与同页的下拉框、分段切换块（Brush.Control.Background / 圆角 6）同族 ——
            全应用「可点的块」都是这个形状，只有输入框用白底描边做区分。
        -->
        <Style x:Key="IoCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.Control.Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Control.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设备连接页的按钮：同款胶囊，字号与表单标签一致（14） -->
        <Style x:Key="FormButton" TargetType="Button" BasedOn="{StaticResource IoCardButton}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <!-- IO 点位项模板 -->
        <DataTemplate x:Key="IoItemTemplate">
            <Border Height="22" Padding="3,0" Margin="0,0,0,2"
                    Background="{DynamicResource Brush.Subtle.Background}" BorderBrush="{DynamicResource Brush.Subtle.Border}"
                    BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="10" Height="10" CornerRadius="5"
                            Background="{Binding StateBrush}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Comment}"
                               MinWidth="144"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Comment}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- IO 列内条目横向拉伸 -->
        <Style x:Key="IoItemsControlStyle" TargetType="ItemsControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 自由监控 ================= -->

        <!-- 行内小按钮（删除 ×） -->
        <Style x:Key="MonitorIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger.Fill.Hover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            表头操作列的图标按钮。与行内 MonitorIconButton 的区别是**悬停配色**：
            行内那个是「删除本项」，悬停变红是对的；表头这两个一个是「新增」（加法，
            变红会让人以为点下去是破坏性操作）、一个是「全部删除」（确实是破坏性，
            但和行内的单行删除共用红色会分不清后果轻重）。
            Add 用主色 Brush.Accent.Fill（与聚焦下划线同色，表示「正向操作」），
            ClearAll 用浅红 Brush.Danger.Subtle 底 + Brush.Danger 字（与日志「已断开」同色系），
            都比整块实心红更克制。
        -->
        <Style x:Key="MonitorHeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Fill}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- 无监控项时不可用（全部删除无意义） -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled.Faint}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            采集任务表的**行内**图标按钮（− + … ↑↓）。

            为什么不用上面那两个：MonitorIconButton 悬停是**红色**（删除语义），
            MonitorHeaderIconButton 悬停是**主色**（新增语义）。这一行里有四个按钮，
            其中「…」和「↑↓」是纯视图操作 —— 套红色会让人以为点下去要删东西，
            套主色又和「+」混在一起分不清。故另起一套**中性**悬停（灰底 + 深字），
            语义靠图标本身和 ToolTip 表达。

            尺寸 22 而非 26：一行里要塞四个，26 会把「共 N 项」挤没。
        -->
        <Style x:Key="AcqRowIconButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Overlay.Medium}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Overlay.Strong}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled.Faint}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            任务组行的「删除本组」按钮。尺寸继承 AcqRowIconButton（22×22，与 … ↑↓ 同高），
            只换悬停配色：**悬停变红**表明破坏性 —— 与全局变量行、监控行的行尾删除一致。
            中性灰悬停的 AcqRowIconButton 留给「…」和「↑↓」，那两个都不删东西。
        -->
        <Style x:Key="AcqRowDeleteButton" TargetType="Button" BasedOn="{StaticResource AcqRowIconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger.Fill.Hover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger.Fill.Hover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            采集任务组行上的「启用」开关。继承 ToggleSwitch，只补一件事：**文案随状态变**。

            ⚠️ 必须在 Style.Triggers 里换 Content，不能写进 ControlTemplate 的触发器 ——
            模板触发器是模板优先级，赢不过控件上的局部 Content（ToggleSwitch 样式里
            已经踩过一次，注释写在那边）。这里不给局部值，Style 的 Setter 才压得住。
        -->
        <Style x:Key="AcqEnableSwitch" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
            <Setter Property="Content" Value="关"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="开"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 「全部删除」：悬停浅红底 + 深红字，与「新增」的主色底区分破坏性语义 -->
        <Style x:Key="MonitorClearAllButton" TargetType="Button"
               BasedOn="{StaticResource MonitorHeaderIconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger.Subtle}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled.Faint}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            「元件名称」输入框：与「当前值」同款的**框线风格**（白底 + 细边框 + 小圆角）。
            表格里两个可编辑格用同一种外观，用户一眼就能看出"这两处能打字"，
            不必靠悬停或尝试去发现。
            文字用 RowBrush —— 配置有误时整行标红，输入框自己也要跟着红。
        -->
        <Style x:Key="MonitorInlineTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Input.Background}"/>
            <Setter Property="Foreground" Value="{Binding RowBrush}"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.Input.Border}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Input.Border.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Input.Background.Disabled}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            采集数据「来源变量」框：名字查不到时**字变红**。
            ⚠️ 不能只靠 ToolTip 提示 —— 用户不知道它错，就不会去悬停，等于没有任何反馈。
            与右侧「数据类型」列的红字同一套语义。
            ⚠️ 必须定义在 MonitorInlineTextBox **之后**：BasedOn 走 StaticResource，
            资源字典按顺序解析，放前面会找不到（解析期就抛）。
        -->
        <Style x:Key="AcquisitionSourceBox" TargetType="TextBox" BasedOn="{StaticResource MonitorInlineTextBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSourceError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            采集数据「写入变量」框：两种状态都要看得见。
            · **不可编辑**（写入类型下还没填来源变量）：靠 MonitorInlineTextBox 模板自带的
              IsEnabled=False 触发器变灰（底色 Brush.Input.Background.Disabled + 字色 Muted），
              这里不必再补一套；
            · **不合法**（变量查不到 / 数据类型与来源变量不同）：字变红，与「来源变量」同一套语义。
            ⚠️ 同样必须定义在 MonitorInlineTextBox 之后（BasedOn 走 StaticResource，按顺序解析）。
        -->
        <Style x:Key="AcquisitionTargetBox" TargetType="TextBox" BasedOn="{StaticResource MonitorInlineTextBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasVariableError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            「当前值」输入框：**框线风格**（白底 + 细边框 + 小圆角），
            与设备连接页的表单输入框一致 —— 行内下拉框是胶囊、这一格是输入框，
            两者本来就不该长得一样。
            读/写失败时边框与文字转琥珀（与 ValueBrush 同色系）。
        -->
        <Style x:Key="MonitorValueTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Input.Background}"/>
            <Setter Property="Foreground" Value="{Binding ValueBrush}"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.Input.Border}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Input.Border.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Input.Background.Disabled}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
                            </Trigger>
                            <!-- 读/写失败：琥珀描边，与文字同色系 -->
                            <DataTrigger Binding="{Binding HasReadError}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasWriteError}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 枚举 → 大写名（显示格式用；BIN/DEC/HEX/ASCII 按惯例全大写） -->
        <DataTemplate x:Key="EnumUpperTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumUpperConverter}}"
                       FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <!--
            数据类型下拉的显示模板（等价于原 DisplayMemberPath="DisplayName"）。
            改成显式 DataTemplate 是因为自定义 ComboBox 模板下
            DisplayMemberPath 不与 SelectionBoxItemTemplate 合成，
            闭合态会退化成 ToString()（实测显示成 "DSH_Modbu"）。
        -->
        <DataTemplate x:Key="MonitorTypeItemTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <!--
            行内下拉框：外观向「分段切换控件」（IoSegmentRadioButton）看齐 ——
            灰底胶囊 Brush.Control.Background + 圆角 6、无边框、无系统立体感，与表头那两个切换项同族。
             灰底胶囊 Brush.Control.Background + 圆角 6、无边框、无系统立体感，与表头那两个切换项同族。
            去掉系统上下微调箭头，只留一个淡淡的 chevron。
        -->
        <Style x:Key="MonitorInlineComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{DynamicResource Brush.Control.Background}"
                                    CornerRadius="6">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!--
                                        ⚠️ 闭合态文字必须走 SelectionBoxItem + SelectionBoxItemTemplate
                                        这一对（WPF 默认模板就是这么接的）。只绑 SelectionBoxItem
                                        会退化成 ToString()（实测类型列显示成 "DSH_Modbu"）。
                                        ⚠️ 同时**不要**在 ComboBox 上用 DisplayMemberPath：
                                        它与自定义模板的 SelectionBoxItemTemplate 不合成，
                                        正确做法是改用 ItemTemplate 指定要显示的属性（见下方控件）。

                                        ⚠️ 这里显示的是 DataTypeSpec.DisplayName（如 INT），
                                        而 **类型列** 要显示 STRING[20]（带长度）—— DataTypeSpec 是共享的
                                        静态目录、没有长度，故类型列另有一套模板，
                                        把文字换成行内 MonitorItem.TypeDisplayName（见 MonitorTypeCombo）。
                                    -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                    <!-- chevron: Segoe Fluent Icons E70D -->
                                    <TextBlock x:Name="Chev"
                                               Grid.Column="1"
                                               Text="&#xE70D;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="9"
                                               Foreground="{DynamicResource Brush.Text.Faint}"
                                               VerticalAlignment="Center"
                                               Margin="8,1,0,0"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="PART_Toggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   VerticalOffset="2"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="{DynamicResource Brush.Popup.Background}"
                                        BorderBrush="{DynamicResource Brush.Popup.Border}" BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉项：去系统高亮，选中行浅灰，与胶囊风格一致 -->
        <Style x:Key="MonitorComboItem" TargetType="ComboBoxItem">
            <!--
                水平内边距 = 4，配合下方 Border 的 Margin="2,1" 合计 6，
                **与闭合态 MonitorInlineComboBox 的 Padding 6 一致** —— 否则展开后
                选中项文字比闭合时更靠右，切换选项时文字会横向跳一下。
            -->
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Ib" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" Margin="2,1">
                            <!--
                                ⚠️ 必须写 ContentSource="Content"：裸 <ContentPresenter/> 不会
                                套用 ComboBox 的 ItemTemplate，条目会退化成对象的 ToString()
                                （实测下拉里显示成 "DSH_Modbus采集工具.Modeling.DataTypeSpec"）。
                            -->
                            <ContentPresenter ContentSource="Content"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ib" Property="Background" Value="{DynamicResource Brush.Control.Background}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ib" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ============ 表单控件样式（设备连接页等非行内场景）============

            与自由监控行内控件**同一套视觉语言**，只把尺寸放大到表单规格：
              行内（自由监控表格）：字号 12，高 22，用于密集表格行
              表单（设备连接页）  ：字号 14，高 30，用于表单字段

            风格分工（两处一致）：**下拉框＝胶囊**（灰底无边框），**输入框＝框线**（白底细边框）。
            这样用户在不同页面看到的「能点开选的」和「能打字的」始终是同一种外观。

            ⚠️ XML 注释里不能出现连续两个减号，所以这里不用 Markdown 表格分隔行。
        -->

        <!--
            表单下拉框：胶囊风格（灰底 Brush.Control.Background、无边框、圆角 6、右侧 chevron），
             表单下拉框：胶囊风格（灰底 Brush.Control.Background、无边框、圆角 6、右侧 chevron），
            下拉面板同样自带圆角描边与阴影区。
        -->
        <!-- 表单下拉项：与行内 MonitorComboItem 同款，仅字号放大 -->
        <Style x:Key="FormComboItem" TargetType="ComboBoxItem">
            <!-- 水平 10 + Border 的 Margin 2 = 12，与闭合态 FormComboBox 的 Padding 12 对齐 -->
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Ib" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" Margin="2,1">
                            <!-- ⚠️ 必须写 ContentSource="Content"：裸 <ContentPresenter/> 会退化成 ToString() -->
                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ib" Property="Background" Value="{DynamicResource Brush.Control.Background}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ib" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <!-- 默认不画框线（模板会读 BorderThickness，不显式置 0 会拿到系统默认的 1） -->
            <Setter Property="BorderThickness" Value="0"/>
            <!--
                下拉项容器样式写在这里，而不是逐个控件加 —— 设备连接页有 8 个下拉框，
                逐个写容易漏（漏掉的那个会用系统默认的蓝色选中条，与胶囊风格明显不搭）。
            -->
            <Setter Property="ItemContainerStyle" Value="{StaticResource FormComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!--
                                框线走 TemplateBinding：默认 BorderThickness=0（见 Style 里的 Setter），
                                所以其余下拉框外观不变；需要「框出来」的地方自己设 1 + Brush.Input.Border。
                                模板里原本完全不看这两个属性，写上去也没效果。
                            -->
                            <Border x:Name="Bd" Background="{DynamicResource Brush.Control.Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!--
                                        ⚠️ 闭合态文字必须走 SelectionBoxItem + SelectionBoxItemTemplate
                                        这一对（WPF 默认模板就是这么接的）。
                                        ⚠️ 不要在本样式上设 DisplayMemberPath —— 它与自定义模板的
                                        SelectionBoxItemTemplate 不合成（见行内版同处注释）。
                                    -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                    <!-- chevron: Segoe Fluent Icons E70D -->
                                    <TextBlock x:Name="Chev"
                                               Grid.Column="1"
                                               Text="&#xE70D;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="{DynamicResource Brush.Text.Faint}"
                                               VerticalAlignment="Center"
                                               Margin="6,2,0,0"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="PART_Toggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   VerticalOffset="2"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="{DynamicResource Brush.Popup.Background}"
                                        BorderBrush="{DynamicResource Brush.Popup.Border}" BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="300">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!--
            表单输入框：框线风格（白底 Brush.Input.Background + Brush.Input.Border 细边框 + 圆角 4），
             表单输入框：框线风格（白底 Brush.Input.Background + Brush.Input.Border 细边框 + 圆角 4），
        -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Input.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.Input.Border}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Input.Border.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Input.Background.Disabled}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            数据类型列的专用模板：闭合态文字取**行内** MonitorItem.TypeDisplayName，
            而不是共享的 DataTypeSpec.DisplayName —— 因为 STRING 要显示成 STRING[20]，
            长度是每行自己的（DataTypeSpec 目录里没有长度）。
            下拉项仍显示纯类型名（候选集不该带某行的长度）。
        -->
        <Style x:Key="MonitorTypeCombo" TargetType="ComboBox"
               BasedOn="{StaticResource MonitorInlineComboBox}">
            <Setter Property="ItemTemplate" Value="{StaticResource MonitorTypeItemTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MonitorComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{DynamicResource Brush.Control.Background}" CornerRadius="6">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 行内显示名（STRING[9]）；数据上下文即该行的 MonitorItem -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TypeDisplayName}"
                                               FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               IsHitTestVisible="False"/>
                                    <TextBlock Grid.Column="1"
                                               Text="&#xE70D;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="9"
                                               Foreground="{DynamicResource Brush.Text.Faint}"
                                               VerticalAlignment="Center"
                                               Margin="4,1,0,0"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="PART_Toggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   VerticalOffset="2"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="{DynamicResource Brush.Popup.Background}"
                                        BorderBrush="{DynamicResource Brush.Popup.Border}" BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自由监控的一行 -->
        <DataTemplate x:Key="MonitorItemTemplate">
            <Border Height="30" Margin="0,0,0,2"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1"
                    Loaded="MonitorRow_Loaded">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>   <!-- 序号 -->
                        <ColumnDefinition Width="100"/>  <!-- 元件名称（符号+编号，方案 2） -->
                        <!-- 106 = 下拉宽 96 + 左间距 6，留 4 余量放 STRING[128] 这类长文本 -->
                        <ColumnDefinition Width="106"/>  <!-- 数据类型 -->
                        <ColumnDefinition Width="88"/>   <!-- 显示格式 ↓ -->
                        <ColumnDefinition Width="*"/>    <!-- 当前值 -->
                        <ColumnDefinition Width="40"/>   <!-- 删除 -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Id}"
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"/>

                    <!-- 元件名称：符号与编号合并输入（方案 2），如 HD100 / X17；
                          也可填已定义的全局变量名。**打字途中不校验**（需求）：
                          失焦或回车时才检查，不合法直接弹窗「不是有效软元件或变量」 -->
                    <TextBox x:Name="NameBox"
                             Grid.Column="1"
                             Style="{StaticResource MonitorInlineTextBox}"
                             KeyDown="MonitorName_KeyDown"
                             LostFocus="MonitorName_LostFocus"
                             Loaded="MonitorName_Loaded"/>

                    <!--
                        数据类型。选 STRING 时会弹框问长度，确认后本框显示 STRING[n]
                        （见 MonitorType_SelectionChanged / DataPoint.TypeDisplayName）。
                        行内不再放长度输入框 —— 改长度＝重选一次 STRING。
                    -->
                    <ComboBox Grid.Column="2" x:Name="TypeCombo"
                              Width="96"
                              Margin="6,0,0,0"
                              HorizontalAlignment="Left"
                              Style="{StaticResource MonitorTypeCombo}"
                              SelectionChanged="MonitorType_SelectionChanged"/>

                    <ComboBox Grid.Column="3" x:Name="FormatCombo"
                              Width="76"
                              HorizontalAlignment="Left"
                              Style="{StaticResource MonitorInlineComboBox}"
                              ItemContainerStyle="{StaticResource MonitorComboItem}"
                              ItemTemplate="{StaticResource EnumUpperTemplate}"
                              SelectionChanged="MonitorFormat_SelectionChanged"/>

                    <!--
                        当前值：可直接编辑，回车或失焦时写入 PLC。
                        轮询回填会跳过正在编辑的格（MonitorItem.IsEditing），
                        否则输入到一半就被下一拍读值覆盖。
                        读/写失败只转琥珀色（红＝配置要改，琥珀＝通讯侧的事）；
                        本表格不设悬停提示。
                    -->
                    <TextBox Grid.Column="4"
                             x:Name="ValueBox"
                             Text="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MonitorValueTextBox}"
                             GotKeyboardFocus="MonitorValue_GotFocus"
                             LostKeyboardFocus="MonitorValue_LostFocus"
                             KeyDown="MonitorValue_KeyDown"/>

                    <Button Grid.Column="5"
                            Content="&#xE711;"
                            ToolTip="删除本项"
                            Style="{StaticResource MonitorIconButton}"
                            Click="RemoveMonitorItem_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            全局变量行（P3.3）。与 MonitorItemTemplate 同几何，差别：
            · 第 1 列是**变量名称**（C 标识符，最长 32），不是元件名；
            · 多一列**映射地址**（可空 = 内存变量）与**注释**；
            · 映射地址只读展示解析结果 —— 用户输入的是元件名（如 HD100），
              绝对地址由驱动解析，不在此显示。
        -->
        <DataTemplate x:Key="GlobalVarItemTemplate">
            <Border Height="30" Margin="0,0,0,2"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1"
                    Loaded="GlobalVarRow_Loaded">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="106"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Id}"
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"/>

                    <!-- 变量名称：C 标识符规则。**打字途中不校验**（需求）：
                         失焦或回车时才检查，不合法弹窗「变量名称不合法」+ 具体规则 -->
                    <TextBox Grid.Column="1" x:Name="VarNameBox"
                             Style="{StaticResource MonitorInlineTextBox}"
                             KeyDown="GlobalVarName_KeyDown"
                             LostFocus="GlobalVarName_LostFocus"/>

                    <ComboBox Grid.Column="2" x:Name="VarTypeCombo"
                              Width="96" Margin="6,0,0,0"
                              HorizontalAlignment="Left"
                              Style="{StaticResource MonitorTypeCombo}"
                              SelectionChanged="GlobalVarType_SelectionChanged"/>

                    <!-- 映射地址：空 = 不关联地址的内存变量 -->
                    <TextBox Grid.Column="3" x:Name="VarAddressBox"
                             Style="{StaticResource MonitorInlineTextBox}"
                             Margin="0,0,6,0"
                             LostFocus="GlobalVarAddress_LostFocus"/>

                    <!-- 注释：仅给人看，不上报、不参与读写 -->
                    <TextBox Grid.Column="4" x:Name="VarCommentBox"
                             Style="{StaticResource MonitorInlineTextBox}"
                             Margin="0,0,6,0"
                             LostFocus="GlobalVarComment_LostFocus"/>

                    <Button Grid.Column="5"
                            Content="&#xE711;"
                            ToolTip="删除本变量"
                            Style="{StaticResource MonitorIconButton}"
                            Click="RemoveGlobalVar_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 系统变量行（P3.5）。与 GlobalVarItemTemplate 同几何，差别：
             · 去掉**映射地址**列与**删除**列；
             · 每格都是 TextBlock —— 清单写死且只读，没有任何输入框 / 下拉框，
               连焦点都拿不到，用户一眼就知道这里不能改；
             · 数据类型也走 TextBlock，与相邻全局变量里的下拉框**底色不同**，
               这个视觉差异本身就在说「这列不可选」。 -->
        <DataTemplate x:Key="SystemVarItemTemplate">
            <Border Height="30" Margin="0,0,0,2"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- 列定义必须与 SystemVarPanel 的表头完全一致 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>   <!-- 序号 -->
                        <ColumnDefinition Width="140"/>  <!-- 变量名称 -->
                        <ColumnDefinition Width="106"/>  <!-- 数据类型 -->
                        <ColumnDefinition Width="*"/>    <!-- 注释 -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Id}"
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="{Binding TypeName}"
                               Margin="6,0,0,0"
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="3" Text="{Binding Comment}"
                               Margin="0,0,6,0"
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ================= 采集任务（P3.1）：数据项行 =================
             子表的一行，**列随任务类型变**：
               · 读取类型：序号 | 项名称[] | 读取变量[] | 数据类型（只读）| 删除
               · 写入类型：序号 | 项名称[] | 来源变量[] | 写入变量[] | 数据类型（只读）| 删除
             · **数据类型只读**（需求）：它由被引用的全局变量反推，故是 TextBlock 不是下拉框 ——
               与旁边两个输入框底色不同，这个视觉差异本身就在说「这列不可选」。
             · 两个变量框都是**能填变量名的地方**，按 P6.5 接全局变量补全（Loaded 里挂）。
             · 变量名填了但表里没有 → 类型列标红（DataTrigger 绑 HasVariableError）。
             · 写入类型下三条硬规则（用户定案 2026-10-27）：
               ① 来源变量没填对之前，**写入变量置灰不可编辑**（IsEnabled 绑 CanEditVariable）；
               ② 写入变量的数据类型必须与来源变量**完全相同**，不同则输入框与类型列同时标红；
               ③ 写入变量**允许未映射地址**（纯内存变量），不算错误 —— 地址是以后补的事。
             ⚠️ 「来源变量」那一列**不是**用 Visibility 藏起来的：列宽由 Style 的 DataTrigger
                在 0 与 150 之间切。用 Visibility 的话列宽仍占着，读取类型下会凭空空出一截。 -->
        <DataTemplate x:Key="AcquisitionItemRowTemplate">
            <Border Height="30" Margin="0,0,0,2"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- 列定义必须与子表表头完全一致 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>   <!-- 序号 -->
                        <ColumnDefinition Width="150"/>  <!-- 项名称 -->

                        <!-- 来源变量：仅写入类型占位。Width 只在 Style 里给，不写属性 ——
                             属性值是局部值，会压过 Style 触发器，列宽就切不动了 -->
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsWrite,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                            <Setter Property="Width" Value="150"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>

                        <ColumnDefinition Width="180"/>  <!-- 读取变量 / 写入变量 -->
                        <ColumnDefinition Width="*"/>    <!-- 数据类型（只读） -->
                        <ColumnDefinition Width="30"/>   <!-- 删除 -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Index}"
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource MonitorInlineTextBox}"
                             Margin="0,0,6,0"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="AcquisitionItemField_LostFocus"/>

                    <!-- 来源变量（仅写入类型可见，列宽为 0 时它自然被挤没）
                         ⚠️ 补全挂的是**另一个**处理器：来源变量可以是系统变量，
                         写入变量不行（要落 PLC 地址） -->
                    <TextBox Grid.Column="2"
                             Style="{StaticResource AcquisitionSourceBox}"
                             Margin="0,0,6,0"
                             Text="{Binding SourceVariableName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding SourceHint}"
                             Loaded="AcquisitionSourceBox_Loaded"
                             LostFocus="AcquisitionItemField_LostFocus"/>

                    <!-- 读取变量 / 写入变量：同一个字段，标题随类型变。
                         · 写入类型下**来源变量填对之前置灰不可编辑**（IsEnabled 绑 CanEditVariable）；
                         · ToolTipService.ShowOnDisabled 必须为真：禁用的控件默认不弹 ToolTip，
                           而「先填来源变量」这句话恰恰只在禁用状态才需要看见。 -->
                    <TextBox Grid.Column="3"
                             Style="{StaticResource AcquisitionTargetBox}"
                             Margin="0,0,6,0"
                             IsEnabled="{Binding CanEditVariable}"
                             ToolTipService.ShowOnDisabled="True"
                             Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding VariableHint}"
                             Loaded="AcquisitionItemVariableBox_Loaded"
                             LostFocus="AcquisitionItemField_LostFocus"/>

                    <TextBlock Grid.Column="4" Text="{Binding TypeDisplayName}"
                               Margin="6,0,6,0"
                               FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding VariableHint}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVariableError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="5"
                            Content="&#xE711;"
                            AutomationProperties.Name="删除本数据项"
                            ToolTip="删除本数据项"
                            Style="{StaticResource MonitorIconButton}"
                            Click="RemoveAcquisitionItem_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ================= 采集任务（P3.1）：任务组行 =================
             上层一行是任务组，展开后是它的数据项子表。

             列：# | 任务名称 | 任务类型 | 执行方式 | 启用 | 共N项 | … ↑↓
             · 任务名称 / 任务类型 / 执行方式 都是**只读文本**，改它们走「…」对话框 ——
               需求样例里这三个位置写的是 {任务组1} / {任务类型} / {执行方式}（花括号＝关联值），
               不是输入框。
             · 增删数据项**不在本行**：+ 在展开后的子表表头右端、删除在每行行尾，
               本行只报「共 N 项」。
             · 展开状态 IsExpanded 是**界面态**，不落盘（见 AcquisitionTaskItem）。 -->
        <DataTemplate x:Key="AcquisitionTaskRowTemplate">
            <Grid Margin="0,0,0,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 任务组行 -->
                    <RowDefinition Height="Auto"/>   <!-- 数据项子表（展开时） -->
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Height="42"
                        Background="Transparent"
                        BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
                    <Grid>
                        <!-- 列定义必须与 AcquisitionDataPanel 的表头完全一致（含最左的 # 列） -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>   <!-- # -->
                            <ColumnDefinition Width="*" MinWidth="120"/>  <!-- 任务名称 -->
                            <ColumnDefinition Width="90"/>   <!-- 任务类型 -->
                            <ColumnDefinition Width="76"/>   <!-- 执行方式（只有「周期」/「触发」两个字，用户定案 2026-10-29；原 140 装的是「周期 5s」） -->
                            <ColumnDefinition Width="180"/>  <!-- 启用（开关 96 + 提示 66，见下） -->
                            <ColumnDefinition Width="80"/>   <!-- 共N项 -->
                            <ColumnDefinition Width="120"/>  <!-- … ↑↓ -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Index}"
                                   FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                   Margin="0,0,12,0"
                                   FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="2" Text="{Binding KindDisplay}"
                                   FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="3" Text="{Binding ScheduleDisplay}"
                                   FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   VerticalAlignment="Center"/>

                        <!-- 启用开关 + 配置错误提示（用户定案 2026-10-27）：
                             配置错误时开关显示为「关」**并且灰掉点不动**，右侧琥珀色文字说明原因。
                             提示只给四个字、不列明细 —— 明细看子表：填错的变量列本来就各自标红了。
                             ⚠️ IsChecked 绑的是 EffectiveEnabled（= 用户意图 && 没有配置错误），
                             不是 Model.Enabled。真去改写模型会把「这个组用户是想启用的」抹掉，
                             而数据管理是边输边存：清空变量名重打的那一瞬间也算配置错误，
                             一旦据此落盘，打完字这组就永久停采了，且没留任何痕迹。 -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource AcqEnableSwitch}"
                                      IsChecked="{Binding EffectiveEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding CanToggleEnabled}"
                                      Click="AcquisitionTaskEnable_Click"/>

                            <TextBlock Margin="8,0,0,0"
                                       Text="{Binding ConfigErrorText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.Warning}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasConfigError, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- 只报数量，**不放按钮**：增删数据项都在子表里（+ 在子表表头右侧、
                             删除在每行行尾），这里再放一套就成两个入口做同一件事 -->
                        <TextBlock Grid.Column="5" Text="{Binding ItemCountText}"
                                   FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="6" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#xE712;"
                                    AutomationProperties.Name="任务选项"
                                    ToolTip="任务选项…"
                                    Style="{StaticResource AcqRowIconButton}"
                                    Click="OpenAcquisitionTaskDialog_Click"/>
                            <Button Content="&#xE711;"
                                    AutomationProperties.Name="删除本任务组"
                                    ToolTip="删除本任务组"
                                    Style="{StaticResource AcqRowDeleteButton}"
                                    Margin="2,0,0,0"
                                    Click="RemoveAcquisitionTask_Click"/>
                            <Button Content="{Binding ExpandGlyph}"
                                    AutomationProperties.Name="展开或收起数据项"
                                    ToolTip="{Binding ExpandToolTip}"
                                    Style="{StaticResource AcqRowIconButton}"
                                    Margin="2,0,0,0"
                                    Click="ToggleAcquisitionTaskExpand_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--
                    展开后的数据项子表：整块套一层**浅底 + 1px 边框 + 圆角**。
                    用户要求「一眼看出这些行属于哪个任务组」—— 只靠缩进不够：
                    缩进只说明了「不在最左」，说不清是哪一组。**成块的底色**才是分组信号，
                    多组同时展开时每块各自成块，边界一眼可见。
                    底色比卡片深一档（深色主题则更深一档），两套主题都是「凹进去」的观感。
                -->
                <!--
                    左边距 0：底色块与「任务名称」表头左对齐（用户定案）。
                    原先这里缩进 34 去对「序号」列，结果底色块比表头窄一截、左边缘参差 ——
                    底色块是**容器**，容器对齐容器（表头）比对齐里面的某一列更自然。
                    内边距 10 负责把序号列从边框上让开（数字压框线，截图一眼可见）。
                -->
                <Border Grid.Row="1" Margin="0,6,0,4"
                        Padding="10,6,8,6"
                        Background="{DynamicResource Brush.Acquisition.SubTable.Background}"
                        BorderBrush="{DynamicResource Brush.Acquisition.SubTable.Border}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 子表表头 -->
                            <RowDefinition Height="Auto"/>   <!-- 数据项行 -->
                        </Grid.RowDefinitions>

                    <!-- 子表表头。右端那个 + 是**加本组的数据项**，位置照自由监控表头
                         （新增按钮压在行尾 × 的正上方，同一列）—— 上下对得齐，一眼看出
                         「这个 + 加的就是下面这些行」。
                         ⚠️ 它与页面表头的 + 不是一回事：那个加的是**任务组**。故两者
                         一个在表头（26×26 主色悬停），一个在子表表头，层级靠位置区分。 -->
                        <Grid Grid.Row="0" Height="26">
                            <Grid>
                                <!-- 列定义必须与 AcquisitionItemRowTemplate 完全一致（含随类型变的来源列） -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>   <!-- 序号 -->
                                    <ColumnDefinition Width="150"/>  <!-- 项名称 -->

                                    <!-- 来源变量：仅写入类型占位，Width 只由 Style 给 -->
                                    <ColumnDefinition>
                                        <ColumnDefinition.Style>
                                            <Style TargetType="ColumnDefinition">
                                                <Setter Property="Width" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWrite}" Value="True">
                                                        <Setter Property="Width" Value="150"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ColumnDefinition.Style>
                                    </ColumnDefinition>

                                    <ColumnDefinition Width="180"/>  <!-- 读取变量 / 写入变量 -->
                                    <ColumnDefinition Width="*"/>    <!-- 数据类型 -->
                                    <ColumnDefinition Width="30"/>   <!-- 行尾 × -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="项名称" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="来源变量" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="读取变量"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWrite}" Value="True">
                                                    <Setter Property="Text" Value="写入变量"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="4" Text="数据类型" FontSize="11" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <!--
                                表头操作区：靠右**叠放**，不参与上面的列布局（同自由监控表头）。
                                顺序按阅读方向：清空 → 新增。
                                ⚠️ 右外边距 2 是算出来的，不是随手写的：行尾 × 那列宽 30、居中，
                                中心在「右边缘 −15」；按钮 26 宽，右距 2 时中心也在「右边缘 −15」，
                                于是 + 正好压在 × 的正上方（实测偏差 0.5px）。
                            -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,2,0">
                                <Button Content="&#xE74D;"
                                        AutomationProperties.Name="清空本组数据项"
                                        ToolTip="清空本组数据项"
                                        Style="{StaticResource MonitorClearAllButton}"
                                        Click="ClearAcquisitionItems_Click"/>
                                <Button Content="&#xE710;"
                                        AutomationProperties.Name="新增数据项"
                                        ToolTip="新增数据项"
                                        Margin="2,0,0,0"
                                        Style="{StaticResource MonitorHeaderIconButton}"
                                        Click="AddAcquisitionItem_Click"/>
                            </StackPanel>
                        </Grid>

                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding Items}"
                                      ItemTemplate="{StaticResource AcquisitionItemRowTemplate}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                        <!-- 空数据项提示。展开一个刚建的任务组时，子表只有表头一片空白，
                             不写一句的话看不出「是空的」还是「没加载出来」。
                             Items.Count 变化会经 ObservableCollection 的 INotifyPropertyChanged 冒上来。 -->
                        <TextBlock Grid.Row="1" Margin="0,8,0,4"
                                   Text="还没有数据项，点上方右侧的 + 添加"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Muted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 系统变量监控行（P2.3）。与 SystemVarItemTemplate 同几何，多一列**当前值**：
             · 全部只读 —— 系统变量由程序计算，用户改不了；
             · 当前值每 100ms 由定时器推一次（跟随本分段可见性启停）。 -->
        <DataTemplate x:Key="SystemVarMonitorItemTemplate">
            <Border Height="30" Margin="0,0,0,2"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
                <Grid>
                    <!-- 列定义必须与 SystemVarMonitorPanel 的表头完全一致 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>   <!-- 序号 -->
                        <ColumnDefinition Width="140"/>  <!-- 变量名称 -->
                        <ColumnDefinition Width="106"/>  <!-- 数据类型 -->
                        <ColumnDefinition Width="110"/>  <!-- 当前值 -->
                        <ColumnDefinition Width="*"/>    <!-- 注释 -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Id}"
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="{Binding TypeName}"
                               Margin="6,0,0,0"
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="3" Text="{Binding Value}"
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="4" Text="{Binding Comment}"
                               Margin="0,0,6,0"
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 细滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Brush.ScrollBar.Thumb}" CornerRadius="4" Margin="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="MinWidth" Value="0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Overlay.Medium}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 日志卡「清空」按钮（文字版，沿用 IoPagerButton 的悬停/按下反馈） -->
        <Style x:Key="LogClearButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LogClearBd" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LogClearBd" Property="Background" Value="{DynamicResource Brush.Control.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LogClearBd" Property="Background" Value="{DynamicResource Brush.Control.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled.Soft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设备状态日志行：[时间] 消息；时间固定灰色，消息按级别着色。
             时间列用 SharedSizeGroup 在各行间共享宽度：否则 Auto 会按本行时间戳实际字宽计算，
             而 Segoe UI 数字是比例字宽（1 比 5/8 窄），含 1 的时间戳更窄 → 消息左边界会左右抖动 -->
        <DataTemplate x:Key="DeviceLogItemTemplate">
            <Grid Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DeviceLogTime"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                           VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12"
                           Foreground="{Binding LevelBrush}"
                           TextWrapping="Wrap" Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- 日志列表：无边框/透明底，去掉条目的选中底色与焦点框（只读展示） -->
        <Style x:Key="DeviceLogListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 标题栏 ================= -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.TitleBar.Background}" BorderBrush="{DynamicResource Brush.TitleBar.Border}" BorderThickness="0,0,0,1">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="数据采集Demo" FontSize="13" Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右侧：窗口按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click"
                        Content="&#xE921;" ToolTip="最小化"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                        Click="MaximizeButton_Click" Content="&#xE922;" ToolTip="最大化"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="CloseButton_Click"
                        Content="&#xE8BB;" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="Transparent"
                    BorderBrush="{DynamicResource Brush.Nav.Border}" BorderThickness="0,0,1,0" Margin="0,0,112,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                        <RadioButton x:Name="OverviewNav"
                                     Style="{StaticResource NavRadioButton}" GroupName="Nav" IsChecked="True"
                                     Content="总览"/>
                        <RadioButton x:Name="StatusInfoNav"
                                     Style="{StaticResource NavRadioButton}" GroupName="Nav"
                                     Content="设备监控"/>
                        <RadioButton x:Name="AcquisitionConfigNav"
                                     Style="{StaticResource NavRadioButton}" GroupName="Nav"
                                     Content="数据管理"/>
                        <RadioButton x:Name="DeviceConfigNav"
                                     Style="{StaticResource NavRadioButton}" GroupName="Nav"
                                     Content="设备连接"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                        <Separator Background="{DynamicResource Brush.Nav.Border}" BorderThickness="0" Margin="16,4,16,8"/>
                        <RadioButton x:Name="SettingsNav"
                                     Style="{StaticResource NavRadioButton}" GroupName="Nav"
                                     Content="设置"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 内容区（商店内容已移除，留空待填充）：下边距 30 给底栏让位 -->
            <!-- 内容区的左右留白（改这块务必看懂，容易一改就全乱）：
                 Margin 左 112 = 让开导航列（导航 Border 是 Margin="0,0,112,0"，
                 右边距 112 → 那根竖分隔线就落在 x=112）；
                 Padding 左/右 = 卡片与「分隔线 / 窗口右缘」之间的呼吸间距。

                 ⚠️ 左右都用同一个 Padding 值，卡片才会在内容区里居中：
                 左边距以**分隔线**（x=112）为基准，右边距以**窗口右缘**为基准，
                 两者本来就都是 Padding，故同值即对称（现为 20）。
                 曾经左 20 / 右 36 是历史遗留的不对称，已统一。

                 四个页面的标题与卡片共用这一个 Padding，改一处即四页同步。 -->
            <ScrollViewer x:Name="ContentScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,4,20,16" Grid.ColumnSpan="2" Margin="112,0,0,30">
                <StackPanel>

                    <!-- 总览：高度取内容区视口高度，下方 1/4 固定给设备状态日志（贴窗口底部）。
                         设计器只认 d:Visibility，本页为设计器默认预览页（切换见 AGENTS.md） -->
                    <Grid x:Name="OverviewPanel" d:Visibility="Visible"
                          Height="{Binding ViewportHeight, ElementName=ContentScrollViewer}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">

                            <!-- 状态机 / 生产数据：整块卡片，视图标签条在卡片**左上角**。
                                 页头那个「总览」大标题已删（2026-10-30 用户定案）：
                                 它下面紧跟一张满宽卡片，标题只是把卡片往下压了一截，
                                 删掉后卡片直接顶到内容区上沿。

                                 Excel 功能区式标签条（ViewTabRadioButton）：一排纯文字，
                                 选中项加粗 + 文字正下方一条色条；没有胶囊底、没有边框、没有下拉箭头。 -->
                            <Border Background="{DynamicResource Brush.Card.Background}"
                                    BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8,12,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>   <!-- 视图标签条 -->
                                        <RowDefinition Height="*"/>      <!-- 状态机 / 生产数据 -->
                                    </Grid.RowDefinitions>

                                    <!-- 标签条左对齐（Excel 页签也从左边起）+ 下方一条分隔线：
                                         没有这条线，标签会紧贴画布上沿、看着像画布的一部分。 -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <RadioButton x:Name="MachineViewTab"
                                                         Content="PLC状态机"
                                                         GroupName="OverviewView"
                                                         Style="{StaticResource ViewTabRadioButton}"
                                                         IsChecked="True"
                                                         Checked="OverviewViewTab_Checked"/>
                                            <RadioButton x:Name="ProductionViewTab"
                                                         Content="生产数据"
                                                         GroupName="OverviewView"
                                                         Margin="28,0,0,0"
                                                         Style="{StaticResource ViewTabRadioButton}"
                                                         Checked="OverviewViewTab_Checked"/>
                                        </StackPanel>
                                        <Border Height="1" Margin="0,6,0,0"
                                                Background="{DynamicResource Brush.Divider}"/>
                                    </StackPanel>

                                    <!-- 画布与「规划中」占位叠在同一格，由标签条切换可见性。
                                         画布本身是固定设计尺寸，由内部的 Viewbox 缩放到本卡片。 -->
                                    <Grid Grid.Row="1">
                                        <ui:MachineStateView x:Name="MachineStateViewControl"/>
                                        <TextBlock x:Name="ProductionDataHint"
                                                   Text="规划中"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="13" Foreground="{DynamicResource Brush.Text.Muted}"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 设备状态日志：只记设备状态（连接/断开/连接失败/心跳告警），空时不显示任何内容
                             与上方卡片留 4 DIP 间隙：不加的话两条 1 DIP 边框会叠成一条 2.67 DIP 的粗线。 -->
                        <Border Grid.Row="1" Margin="0,6,0,0" Background="{DynamicResource Brush.Card.Background}"
                                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="10,4,10,2">
                                    <TextBlock Text="运行日志"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="ClearDeviceLogButton" Content="清空"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource LogClearButton}"
                                            Click="ClearDeviceLogButton_Click"/>
                                </Grid>
                                <!-- 日志显示区：内嵌框线，与卡片留白区分开 -->
                                <Border Grid.Row="1" Margin="10,0,10,10"
                                        Background="{DynamicResource Brush.Card.Background}"
                                        BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                        CornerRadius="4" Padding="8,6,2,6">
                                    <ListBox x:Name="DeviceLogList"
                                             Grid.IsSharedSizeScope="True"
                                             Style="{StaticResource DeviceLogListStyle}"
                                             ScrollViewer.ScrollChanged="DeviceLogList_ScrollChanged"
                                             ItemTemplate="{StaticResource DeviceLogItemTemplate}" d:ItemsSource="{d:SampleData ItemCount=5}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!--
                        设备监控 / IO 监控。
                        面板高度绑内容区视口高度（同 OverviewPanel 的做法），使卡片**撑满**剩余空间，
                        底部的「导入 IO 表 + 分页」因此能常驻可见 —— 卡片若按内容自适应，
                        点位一多就把底部操作行顶到视口之外。
                    -->
                    <Grid x:Name="StatusInfoPanel" Visibility="Collapsed" d:Visibility="Collapsed"
                          Height="{Binding ViewportHeight, ElementName=ContentScrollViewer}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 标题 -->
                            <RowDefinition Height="*"/>      <!-- 卡片（撑满剩余） -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="设备监控"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"
                                   Margin="0,10,0,10"/>

                        <Border Grid.Row="1" Background="{DynamicResource Brush.Card.Background}"
                                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>   <!-- 分段切换 -->
                                    <RowDefinition Height="Auto"/>   <!-- 分隔线 -->
                                    <RowDefinition Height="*"/>      <!-- 列表（占满剩余，超出则内部滚动） -->
                                    <RowDefinition Height="Auto"/>   <!-- 底部操作行：导入 IO 表 + 分页 -->
                                </Grid.RowDefinitions>

                                <!-- 分段切换（输入监控 / 输出监控 / 自由监控） -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Border Background="{DynamicResource Brush.Control.Background}" CornerRadius="6" Padding="2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="XViewSegment"
                                                         Content="输入监控"
                                                         GroupName="IoView"
                                                         IsChecked="True"
                                                         Style="{StaticResource IoSegmentRadioButton}"
                                                         Checked="IoView_Checked"/>
                                            <RadioButton x:Name="YViewSegment"
                                                         Content="输出监控"
                                                         GroupName="IoView"
                                                         Style="{StaticResource IoSegmentRadioButton}"
                                                         Checked="IoView_Checked"/>
                                            <RadioButton x:Name="FreeViewSegment"
                                                         Content="自由监控"
                                                         GroupName="IoView"
                                                         Style="{StaticResource IoSegmentRadioButton}"
                                                         Checked="IoView_Checked"/>
                                            <RadioButton x:Name="SysVarViewSegment"
                                                         Content="系统变量"
                                                         GroupName="IoView"
                                                         Style="{StaticResource IoSegmentRadioButton}"
                                                         Checked="IoView_Checked"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 分隔线：控件行与 IO 点位表格之间 -->
                                <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Divider}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=FreeViewSegment}" Value="True">
                                                    <Setter Property="Margin" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!--
                                    Row=2：三个分段共用这一格，同一时刻只有一个可见（IoView_Checked 切换）。

                                    ⚠️ 滚动分两层，但**同一时刻只有一条滚动条**：
                                    X/Y 分段每页固定 64 点（见 IoPager），超出时由 IoScrollViewer 滚；
                                    自由监控的表头必须常驻 —— 它是「+」的落点、也是整页的列说明 ——
                                    故表头不进 IoScrollViewer，而是让 FreeMonitorPanel 自己填满 Row=2，
                                    只让中间的列表滚动。
                                    历史上自由监控把表头一起塞进外层 ScrollViewer，又在列表外另套
                                    一个 `MaxHeight="380"` 的 ScrollViewer，于是列表一超过 380 就内外
                                    两条滚动条同时出现（X/Y 没有里层，所以只有自由监控出问题）。
                                -->
                                <Grid Grid.Row="2">
                                <!-- X/Y 分段（含空提示）：超出时由这层滚动 -->
                                <ScrollViewer x:Name="IoScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                <!-- X/Y 两个分段叠放：同一时刻只有一个可见（IoView_Checked 切换） -->
                                <Grid>
                                <!-- 输入监控（X0–X77） -->
                                <Grid x:Name="IoColumnsGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ItemsControl x:Name="IoColumn0" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="IoColumn1" Grid.Column="1" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="IoColumn2" Grid.Column="2" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="IoColumn3" Grid.Column="3"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                </Grid>

                                <!-- 输出监控（Y0–Y77，默认隐藏） -->
                                <Grid x:Name="YIoColumnsGrid" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ItemsControl x:Name="YIoColumn0" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="YIoColumn1" Grid.Column="1" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="YIoColumn2" Grid.Column="2" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="YIoColumn3" Grid.Column="3"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                </Grid>

                                <!-- 空状态占位：未导入 IO 表 / 本分段无点位时显示 -->
                                <TextBlock x:Name="IoEmptyHint"
                                           Text="尚未导入 IO 表"
                                           Visibility="Collapsed"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           Margin="0,6,0,4"/>
                                </Grid>
                                </ScrollViewer>

                                <!-- ================= 自由监控（默认隐藏） =================
                                     表格式：表头 + 行。元件名称合并输入（方案 2），
                                     按驱动校验元件名，报错给出具体原因。
                                     当前值列本阶段为占位「—」—— 读取链路属下一步。 -->
                                <Grid x:Name="FreeMonitorPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>   <!-- 表头（常驻，不随列表滚动） -->
                                        <RowDefinition Height="*"/>      <!-- 列表（自身滚动）+ 空状态 -->
                                    </Grid.RowDefinitions>

                                    <!--
                                        表头行。外层 Grid 把「列表头」与「计数 + 全部删除」叠在同一行里，
                                        不必再手工估负边距（那样两边按钮会差几像素），
                                        也不必往列表头里加列（那样会挤窄 `*` 列使「+」错位）。

                                        ⚠️ 垂直几何：表头与数据行都用「Border + 自身下边框」，
                                        而不是「自然高度文本 + 另加一条 Border 分隔线」——
                                        后者文本行高随字体变化，分隔线又带独立 Margin，
                                        结果表头文字既不对齐行内容、也不居中于上下两条线。

            ⚠️ 分隔线颜色用 `Brush.Divider`（= 卡片边框色），**不要用底栏色 `Brush.StatusBar.Background`**：
            后者与卡片底色 `Brush.Card.Background` 只差 3 级，在 150% DPI 下经缩放
             后者与卡片底色 `Brush.Card.Background` 只差 3 级，在 150% DPI 下经缩放

                                        自由监控时将上分隔线的 8 DIP 下边距并入原 38 DIP 表头，
                                        使文字和按钮在两条线之间居中，同时保持分隔线与数据行位置不变。 -->
                                    <Border x:Name="MonitorHeaderGrid"
                                            Grid.Row="0"
                                            Height="46"
                                            Margin="0,0,0,2"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource Brush.Divider}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <!--
                                                列表头（列定义必须与 MonitorItemTemplate 完全一致：
                                                同 6 列、同宽度。多一列会挤窄 `*`，使整条横向错位）。
                                            -->
                                            <Grid x:Name="MonitorHeaderColumns">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>   <!-- 序号 -->
                                                    <ColumnDefinition Width="100"/>  <!-- 元件 -->
                                                    <ColumnDefinition Width="106"/>  <!-- 数据类型（+ STRING 长度），随模板同步 -->
                                                    <ColumnDefinition Width="88"/>   <!-- 显示格式 -->
                                                    <ColumnDefinition Width="*"/>    <!-- 当前值 -->
                                                    <ColumnDefinition Width="40"/>   <!-- 行内删除列（表头留空） -->
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="元件名称" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                <!--
                                                    ⚠️ 第 2 列文字要带 Margin="6,0,0,0"，与该列下拉框的左边距一致 ——
                                                    否则文字贴列左边缘、下拉框右移 6，表头与内容看着错开。
                                                -->
                                                <TextBlock Grid.Column="2" Text="数据类型" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="显示格式" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="当前值" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                <!-- 第 5 列留空：与行内 × 同列，保留列宽使「当前值」宽度与行一致 -->
                                            </Grid>

                                            <!--
                                                表头操作区：靠右叠放，**不参与**列表头的列布局。
                                                顺序按用户要求：计数 → 🗑 全部删除 → + 新增（+ 在最右）。
                                            -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,0,7,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="MonitorCountText"
                                                           FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <Button x:Name="ClearMonitorItemsButton"
                                                        Content="&#xE74D;"
                                                        ToolTip="删除全部监控项"
                                                        Style="{StaticResource MonitorClearAllButton}"
                                                        Click="ClearMonitorItems_Click"/>
                                                <Button x:Name="AddMonitorItemButton"
                                                        Content="&#xE710;"
                                                        ToolTip="新增监控项"
                                                        Margin="6,0,0,0"
                                                        Style="{StaticResource MonitorHeaderIconButton}"
                                                        Click="AddMonitorItemButton_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!--
                                        列表（Row=1）：**只在这里滚动，且不写 MaxHeight**。
                                        高度由 Row=1 的 `*` 行给出 —— 面板整体已绑 ViewportHeight，
                                        故这里就是真实剩余空间；写死高度正是「两条滚动条」的病根：
                                        527f2e2 给列表套了 `MaxHeight="380"` 之后，列表一超过 380
                                        里层先滚、里层滚不动了外层再滚，两条并存。
                                    -->
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="MonitorItemsControl"
                                                      HorizontalContentAlignment="Stretch"
                                                      ItemTemplate="{StaticResource MonitorItemTemplate}">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- 空状态：与列表同格、顶部对齐 —— 列表为空时正好落在表头下方，
                                         与「列表只有一条滚动条」的几何一致 -->
                                    <TextBlock x:Name="MonitorEmptyHint"
                                               Grid.Row="1"
                                               VerticalAlignment="Top"
                                               Text="尚未添加监控项，点击右上角 + 添加"
                                               Visibility="Collapsed"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               Margin="0,10,0,6"/>
                                </Grid>

                                <!-- ================= 系统变量监控（P2.3，默认隐藏） =================
                                     清单写死、全部只读，只多一列「当前值」——
                                     值由 100ms 定时器推，跟随本分段可见性启停（见 MainWindow.xaml.cs）。
                                     表格式与自由监控同为「表头常驻、只让列表滚动」，故不写 MaxHeight。 -->
                                <Grid x:Name="SystemVarMonitorPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>   <!-- 表头（常驻） -->
                                        <RowDefinition Height="*"/>      <!-- 列表（自身滚动） -->
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Height="46"
                                            Margin="0,0,0,2"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource Brush.Divider}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <!-- 列定义必须与 SystemVarMonitorItemTemplate 完全一致 -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>   <!-- 序号 -->
                                                    <ColumnDefinition Width="140"/>  <!-- 变量名称 -->
                                                    <ColumnDefinition Width="106"/>  <!-- 数据类型 -->
                                                    <ColumnDefinition Width="110"/>  <!-- 当前值 -->
                                                    <ColumnDefinition Width="*"/>    <!-- 注释 -->
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="变量名称" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="数据类型" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="当前值" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="注释" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- 只有计数：清单写死，既不能增也不能删 -->
                                            <TextBlock x:Name="SystemVarMonitorCountText"
                                                       FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,7,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="SystemVarMonitorItemsControl"
                                                      HorizontalContentAlignment="Stretch"
                                                      ItemTemplate="{StaticResource SystemVarMonitorItemTemplate}">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                                </Grid>

                                <!--
                                    卡片底部操作行（左：导入 IO 表；右：分页）。
                                    放在卡片内、且列表区用 `*` 占满剩余 —— 卡片撑满视口高度，
                                    故这一行恒定贴在卡片底边，不随点位多少浮动。

                                    ⚠️ 两者在自由监控分段下由 IoView_Checked 隐藏（自由监控有自己的
                                    「新增监控项」按钮，导入 IO 表与 IO 分页对它无意义）。
                                -->
                                <Grid x:Name="IoFooterBar" Grid.Row="3" Margin="0,10,0,0">
                                    <Button x:Name="ImportIoTableButton"
                                            Content="导入 IO 表"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Style="{StaticResource IoCardButton}"
                                            Click="ImportIoTableButton_Click"/>

                                    <StackPanel x:Name="IoPagerPanel"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <Button x:Name="IoPrevPageButton"
                                                Content="&#xE76B;"
                                                ToolTip="上一页"
                                                Style="{StaticResource IoPagerButton}"
                                                Click="IoPrevPageButton_Click"/>
                                        <TextBlock x:Name="IoPageText"
                                                   Text="1/1"
                                                   MinWidth="46"
                                                   TextAlignment="Center"
                                                   FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="IoNextPageButton"
                                                Content="&#xE76C;"
                                                ToolTip="下一页"
                                                Style="{StaticResource IoPagerButton}"
                                                Click="IoNextPageButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= 数据管理 =================
                         两个分段：采集数据（P3.1，占位）/ 全局变量（P3.3，已实现）。
                         分段的写法照抄设备监控页（IoSegmentRadioButton + 同格叠放），
                         保持两页的切换手感一致。

                         立页的意义不止占位 —— 该导航项原先没有对应面板，点进去会把
                         所有面板都隐藏（白屏），与 §10.5 里 SettingsNav 漏 x:Name 是同一类缺陷。 -->
                    <Grid x:Name="AcquisitionConfigPanel" Visibility="Collapsed"
                          d:Visibility="Collapsed"
                          Height="{Binding ViewportHeight, ElementName=ContentScrollViewer}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 标题 -->
                            <RowDefinition Height="*"/>      <!-- 卡片（撑满剩余） -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="数据管理"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Margin="0,10,0,10"/>

                        <Border Grid.Row="1" Background="{DynamicResource Brush.Card.Background}"
                                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>   <!-- 分段切换 -->
                                    <RowDefinition Height="Auto"/>   <!-- 分隔线 -->
                                    <RowDefinition Height="*"/>      <!-- 内容（占满剩余） -->
                                </Grid.RowDefinitions>

                                <!-- 分段切换（采集数据 / 全局变量） -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Border Background="{DynamicResource Brush.Control.Background}" CornerRadius="6" Padding="2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="AcquisitionDataSegment"
                                                         Content="采集数据"
                                                         GroupName="AcqView"
                                                         IsChecked="True"
                                                         Style="{StaticResource IoSegmentRadioButton}"
                                                         Checked="AcqView_Checked"/>
                                            <RadioButton x:Name="GlobalVarSegment"
                                                         Content="全局变量"
                                                         GroupName="AcqView"
                                                         Style="{StaticResource IoSegmentRadioButton}"
                                                         Checked="AcqView_Checked"/>
                                            <RadioButton x:Name="SystemVarSegment"
                                                         Content="系统变量"
                                                         GroupName="AcqView"
                                                         Style="{StaticResource IoSegmentRadioButton}"
                                                         Checked="AcqView_Checked"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.Divider}" Margin="0,0,0,8"/>

                                <Grid Grid.Row="2">
                                    <!-- 采集数据（P3.1）
                                         表格式：表头 + 任务组（可展开成数据项子表），
                                         与全局变量表同为「表头常驻、只让列表滚动」，故不写 MaxHeight。
                                         ⚠️ 本版只做 UI：采集/CSV 落盘都还没接（见 Brief P3.1）。 -->
                                    <Grid x:Name="AcquisitionDataPanel">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>   <!-- 表头（常驻） -->
                                            <RowDefinition Height="*"/>      <!-- 列表（自身滚动）+ 空状态 -->
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Height="46"
                                                Margin="0,0,0,2"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource Brush.Divider}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <!-- 列定义必须与 AcquisitionTaskRowTemplate 完全一致 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>   <!-- # -->
                                                        <ColumnDefinition Width="*" MinWidth="120"/>  <!-- 任务名称 -->
                                                        <ColumnDefinition Width="90"/>   <!-- 任务类型 -->
                                                        <ColumnDefinition Width="76"/>   <!-- 执行方式（只有「周期」/「触发」两个字，用户定案 2026-10-29；原 140 装的是「周期 5s」） -->
                                                        <ColumnDefinition Width="180"/>  <!-- 启用 -->
                                                        <ColumnDefinition Width="80"/>   <!-- 数据项 -->
                                                        <ColumnDefinition Width="120"/>  <!-- 操作（占位，见右侧按钮） -->
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 表头写 "#" 而非「序号」：这一列只有 34 宽，两个字放不下；
                                                         项目里所有表格的序号列都是这个写法，保持一致 -->
                                                    <TextBlock Grid.Column="0" Text="#" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="任务名称" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="任务类型" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="执行方式" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="启用" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="数据项" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- 页面级操作：任务组计数 + 全部删除 + 新增。
                                                     与全局变量表同款放在表头最右，**不能**塞进「数据项」列 ——
                                                     那一列是行内的「共N项」，两套东西挨着会分不清是给谁的。 -->
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,0,7,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock x:Name="AcquisitionTaskCountText"
                                                               FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                    <Button x:Name="ClearAcquisitionTasksButton"
                                                            Content="&#xE74D;"
                                                            AutomationProperties.Name="删除全部任务组"
                                                            ToolTip="删除全部任务组"
                                                            Style="{StaticResource MonitorClearAllButton}"
                                                            Click="ClearAcquisitionTasks_Click"/>
                                                    <Button x:Name="AddAcquisitionTaskButton"
                                                            Content="&#xE710;"
                                                            AutomationProperties.Name="新增任务组"
                                                            ToolTip="新增任务组"
                                                            Margin="6,0,0,0"
                                                            Style="{StaticResource MonitorHeaderIconButton}"
                                                            Click="AddAcquisitionTask_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 列表：只在这里滚动 -->
                                        <ScrollViewer Grid.Row="1"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="AcquisitionTaskItemsControl"
                                                          HorizontalContentAlignment="Stretch"
                                                          ItemTemplate="{StaticResource AcquisitionTaskRowTemplate}">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <TextBlock x:Name="AcquisitionEmptyHint"
                                                   Grid.Row="1"
                                                   VerticalAlignment="Top"
                                                   Text="尚未添加任务组，点击右上角 + 新增"
                                                   Visibility="Collapsed"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   Margin="0,10,0,6"/>
                                    </Grid>

                                    <!-- 全局变量（P3.3）
                                         表格式：表头 + 行，与自由监控同一套几何
                                         （表头常驻、只让列表滚动、不写 MaxHeight）。 -->
                                    <Grid x:Name="GlobalVarPanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>   <!-- 表头（常驻） -->
                                            <RowDefinition Height="*"/>      <!-- 列表（自身滚动）+ 空状态 -->
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Height="46"
                                                Margin="0,0,0,2"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource Brush.Divider}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <!-- 列定义必须与 GlobalVarItemTemplate 完全一致 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>   <!-- 序号 -->
                                                        <ColumnDefinition Width="140"/>  <!-- 变量名称 -->
                                                        <ColumnDefinition Width="106"/>  <!-- 数据类型 -->
                                                        <ColumnDefinition Width="140"/>  <!-- 映射地址 -->
                                                        <ColumnDefinition Width="*"/>    <!-- 注释 -->
                                                        <ColumnDefinition Width="40"/>   <!-- 删除 -->
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="#" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="变量名称" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="数据类型" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="映射地址" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="注释" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,0,7,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock x:Name="GlobalVarCountText"
                                                               FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                    <Button x:Name="ClearGlobalVarsButton"
                                                            Content="&#xE74D;"
                                                            ToolTip="删除全部变量"
                                                            Style="{StaticResource MonitorClearAllButton}"
                                                            Click="ClearGlobalVars_Click"/>
                                                    <Button x:Name="AddGlobalVarButton"
                                                            Content="&#xE710;"
                                                            ToolTip="新增变量"
                                                            Margin="6,0,0,0"
                                                            Style="{StaticResource MonitorHeaderIconButton}"
                                                            Click="AddGlobalVar_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 列表：只在这里滚动，且不写 MaxHeight -->
                                        <ScrollViewer Grid.Row="1"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="GlobalVarItemsControl"
                                                          HorizontalContentAlignment="Stretch"
                                                          ItemTemplate="{StaticResource GlobalVarItemTemplate}">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <TextBlock x:Name="GlobalVarEmptyHint"
                                                   Grid.Row="1"
                                                   VerticalAlignment="Top"
                                                   Text="尚未添加变量，点击右上角 + 添加"
                                                   Visibility="Collapsed"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   Margin="0,10,0,6"/>
                                    </Grid>

                                    <!-- 系统变量（P3.5）
                                         内容写死、全只读：只有表头 + 16 行文本，没有 + / 删除按钮。
                                         表格式与全局变量同为「表头常驻、只让列表滚动」，故不写 MaxHeight。 -->
                                    <Grid x:Name="SystemVarPanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>   <!-- 表头（常驻） -->
                                            <RowDefinition Height="*"/>      <!-- 列表（自身滚动） -->
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Height="46"
                                                Margin="0,0,0,2"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource Brush.Divider}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <!-- 列定义必须与 SystemVarItemTemplate 完全一致 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>   <!-- 序号 -->
                                                        <ColumnDefinition Width="140"/>  <!-- 变量名称 -->
                                                        <ColumnDefinition Width="106"/>  <!-- 数据类型 -->
                                                        <ColumnDefinition Width="*"/>    <!-- 注释 -->
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="#" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="变量名称" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="数据类型" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="注释" FontSize="12" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- 只有计数：清单写死，既不能增也不能删 -->
                                                <TextBlock x:Name="SystemVarCountText"
                                                           FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,0,7,0"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- 列表：只在这里滚动，且不写 MaxHeight -->
                                        <ScrollViewer Grid.Row="1"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="SystemVarItemsControl"
                                                          HorizontalContentAlignment="Stretch"
                                                          ItemTemplate="{StaticResource SystemVarItemTemplate}">
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 设备连接 -->
                    <StackPanel x:Name="DeviceConfigPanel"
                                 Visibility="Collapsed"
                                 d:Visibility="Collapsed">
                        <TextBlock Text="设备连接"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"
                                   Margin="0,10,0,10"/>

                        <Border Background="{DynamicResource Brush.Card.Background}"
                                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                CornerRadius="8" Padding="20">
                            <StackPanel>

                                <!-- 连接方式 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="连接方式"
                                               Width="80"
                                               FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ConnectionTypeComboBox"
                                              Width="200"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource FormComboBox}"
                                              SelectedIndex="0"
                                              SelectionChanged="ConnectionTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="以太网"/>
                                        <ComboBoxItem Content="串口"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 协议类型 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="协议类型"
                                               Width="80"
                                               FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ProtocolTypeComboBox"
                                              Width="200"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource FormComboBox}"
                                              SelectedIndex="0"
                                              SelectionChanged="ProtocolTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="ModbusTCP"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 设备类型 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="设备类型"
                                               Width="80"
                                               FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="DeviceTypeComboBox"
                                              Width="200"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource FormComboBox}"
                                              SelectionChanged="DeviceTypeComboBox_SelectionChanged"/>
                                </StackPanel>

                                <!-- 采集周期 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="采集周期"
                                               Width="80"
                                               FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="PollIntervalComboBox"
                                              Width="200"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource FormComboBox}"
                                              SelectedIndex="0"
                                              SelectionChanged="PollIntervalComboBox_SelectionChanged">
                                        <ComboBoxItem Content="100 ms" Tag="100"/>
                                        <ComboBoxItem Content="200 ms" Tag="200"/>
                                        <ComboBoxItem Content="500 ms" Tag="500"/>
                                        <ComboBoxItem Content="1 s" Tag="1000"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 以太网专属选项 -->
                                <StackPanel x:Name="EthernetOptionsPanel">

                                    <!-- 目标网卡 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="目标网卡"
                                                   Width="80"
                                                   FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox x:Name="TargetNicComboBox"
                                                  Width="200"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource FormComboBox}"
                                                  SelectionChanged="TargetNicComboBox_SelectionChanged"/>
                                        <Button x:Name="RefreshNicButton"
                                                Content="刷新"
                                                Width="60"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource FormButton}"
                                                Click="RefreshNicButton_Click"/>
                                    </StackPanel>

                                    <!-- IP -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="IP地址"
                                                   Width="80"
                                                   FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBox x:Name="IpTextBox"
                                                 Width="200"
                                                 Style="{StaticResource FormTextBox}"
                                                 Text="192.168.1.100"
                                                 TextChanged="ConfigInput_TextChanged"
                                                 LostFocus="ConfigInput_LostFocus"/>
                                        <Button x:Name="ConnectButton"
                                                Content="连接"
                                                Width="60"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource FormButton}"
                                                Click="ConnectButton_Click"/>
                                    </StackPanel>

                                    <!-- 端口号 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="端口号"
                                                   Width="80"
                                                   FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBox x:Name="PortTextBox"
                                                 Width="200"
                                                 Style="{StaticResource FormTextBox}"
                                                 Text="502"
                                                 TextChanged="ConfigInput_TextChanged"
                                                 LostFocus="ConfigInput_LostFocus"/>
                                    </StackPanel>

                                </StackPanel>

                                <!-- 分隔线：连接参数与地址表元件（上方 16 由末行表单提供，上下对称；串口模式下末行为采集周期，同样成立） -->
                                <Border Height="1" Background="{DynamicResource Brush.Divider}" Margin="0,0,0,16"/>

                                <!-- 地址区标题 -->
                                <TextBlock Text="设备通讯区域"
                                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"
                                           Margin="0,0,0,12"/>

                                <!-- ===== 设备通讯区域：左「字节顺序」 | 竖分隔线 | 右「地址表元件」 =====
                                     左右并排而非上下堆叠 —— 5 行压成 3 行，窗口最小（1024×640）时也能完整显示。
                                     两栏各自内部纵向排列；分隔线用 1px Border，随该行高度自然拉伸。 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ===== 左：字节顺序（数据解释方式，随设备类型切换默认值） =====
                                         仅对「寄存器（字）」类数据有意义；线圈/位无字节序。
                                         选项文案用 1-2-3-4 记号：1=最高字节 … 4=最低字节，
                                         名称即这 4 个字节在字节流里的排列顺序。
                                         字符串只管寄存器内 2 个字符的先后，不涉及字序。 -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="32位整数字节顺序"
                                                       Width="140"
                                                       FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox x:Name="Int32OrderComboBox"
                                                      Width="200"
                                                      VerticalAlignment="Center"
                                              Style="{StaticResource FormComboBox}"
                                                      ToolTip="32 位整数占 2 个连续寄存器。1=最高字节 … 4=最低字节；名称即 4 个字节在字节流里的顺序。信捷 XD 实测为 3412（低字在前）。与下方浮点字序互不影响。"
                                                      SelectionChanged="ByteOrderComboBox_SelectionChanged">
                                                <ComboBoxItem Content="1234（大端，高字在前）"/>
                                                <ComboBoxItem Content="2143（字内字节交换，高字在前）"/>
                                                <ComboBoxItem Content="3412（字交换，低字在前）"/>
                                                <ComboBoxItem Content="4321（小端，低字在前）"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="32位浮点数字节顺序"
                                                       Width="140"
                                                       FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox x:Name="FloatOrderComboBox"
                                                      Width="200"
                                                      VerticalAlignment="Center"
                                              Style="{StaticResource FormComboBox}"
                                                      ToolTip="REAL 独占一套字序，与上面的 32 位整数互不影响（改这里不会改变整数解释，反之亦然）。信捷 XD 实测为 3412。"
                                                      SelectionChanged="ByteOrderComboBox_SelectionChanged">
                                                <ComboBoxItem Content="1234（大端，高字在前）"/>
                                                <ComboBoxItem Content="2143（字内字节交换，高字在前）"/>
                                                <ComboBoxItem Content="3412（字交换，低字在前）"/>
                                                <ComboBoxItem Content="4321（小端，低字在前）"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="字符串字节顺序"
                                                       Width="140"
                                                       FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox x:Name="StringOrderComboBox"
                                                      Width="200"
                                                      VerticalAlignment="Center"
                                              Style="{StaticResource FormComboBox}"
                                                      ToolTip="每个寄存器存 2 个字符（1=第 1 个字符，2=第 2 个字符）。信捷 XD 实测为 12（第 1 个字符在高字节）。字符串只有字节先后，没有字序。"
                                                      SelectionChanged="ByteOrderComboBox_SelectionChanged">
                                                <ComboBoxItem Content="12（第 1 个字符在高字节）"/>
                                                <ComboBoxItem Content="21（第 1 个字符在低字节）"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ===== 中间：竖分隔线 ===== -->
                                    <Border Grid.Column="1"
                                            Width="1" Background="{DynamicResource Brush.Divider}"
                                            Margin="20,0,20,0"
                                            VerticalAlignment="Stretch"/>

                                    <!-- ===== 右：当前设备类型的 Modbus 地址表元件（悬停查看各段范围与点数） ===== -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="线圈区"
                                                       Width="80"
                                                       FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
                                                       VerticalAlignment="Center"/>
                                            <ItemsControl x:Name="CoilAreaItems"
                                                          Style="{StaticResource AreaItemsControlStyle}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="寄存器区"
                                                       Width="80"
                                                       FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
                                                       VerticalAlignment="Center"/>
                                            <ItemsControl x:Name="RegisterAreaItems"
                                                          Style="{StaticResource AreaItemsControlStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= 设置（P5） =================
                         主题外观（P5-1）+ 日志保存（P5-2）+ 项目信息（P5-3），见 Brief.md P5。
                         三张卡都是实装；项目信息的值由 AppInfo + csproj 生成的构建日期常量提供。 -->
                    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed"
                                d:Visibility="Collapsed">

                        <TextBlock Text="设置"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Margin="0,10,0,10"/>

                        <!-- 显示外观 -->
                        <Border Background="{DynamicResource Brush.Card.Background}"
                                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                CornerRadius="8" Padding="24,20,24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左：标题 + 说明 -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="显示外观"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <TextBlock Text="选择浅色、深色，或跟随 Windows 的应用主题设置。"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- 右：分段切换（与 IO 页的 X/Y 分段同款轨道） -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource Brush.Control.Background}"
                                        CornerRadius="6" Padding="2"
                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeLightSegment"
                                                     Style="{StaticResource IoSegmentRadioButton}"
                                                     GroupName="Theme"
                                                     Content="浅色"
                                                     Checked="ThemeSegment_Checked"/>
                                        <RadioButton x:Name="ThemeDarkSegment"
                                                     Style="{StaticResource IoSegmentRadioButton}"
                                                     GroupName="Theme"
                                                     Content="深色"
                                                     Checked="ThemeSegment_Checked"/>
                                        <RadioButton x:Name="ThemeSystemSegment"
                                                     Style="{StaticResource IoSegmentRadioButton}"
                                                     GroupName="Theme"
                                                     Content="跟随系统"
                                                     Checked="ThemeSegment_Checked"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 自动连接：一张卡装一组开关，后续同组还会加（如 MES 连接）。
                             卡片标题就是这一组的名字，子项各自一行、右侧一个开关 ——
                             与「日志保存」卡同款两列，眼睛一次扫完。 -->
                        <Border Background="{DynamicResource Brush.Card.Background}"
                                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                CornerRadius="8" Padding="24,20,24,20" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="自动连接"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                <TextBlock Text="设置程序启动后自动连接"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           Margin="0,4,0,0"/>

                                <!-- 子项：PLC 连接（默认打开） -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="PLC连接"
                                               FontSize="14"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"/>

                                    <CheckBox x:Name="AutoConnectPlcToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              Content="开"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center"
                                              Checked="AutoConnectPlcToggle_Changed"
                                              Unchecked="AutoConnectPlcToggle_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 日志保存（P5-2） -->
                        <Border Background="{DynamicResource Brush.Card.Background}"
                                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                CornerRadius="8" Padding="24,20,24,20" Margin="0,16,0,0">
                            <StackPanel>
                                <!-- 开关行：左标题 + 右开关（与「显示外观」卡同款两列）
                                     开关自带状态文字「开 / 关」在左侧，故不再单列「启用」标签 ——
                                     文字与控件紧挨着，眼睛一次扫完，不用跨行配对 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="日志保存"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"/>

                                    <CheckBox x:Name="LogSaveToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              Content="开"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center"
                                              Checked="LogSaveToggle_Changed"
                                              Unchecked="LogSaveToggle_Changed"/>
                                </Grid>

                                <!-- 保存路径：标签与输入框**同一行**（改完失焦生效） + 按钮
                                     标签放左列、与输入框垂直居中，故不再单独占一行 ——
                                     标签独行时它与它描述的那个框隔着一整行，视线要上下跳。
                                     标签列用 Auto（本页项目信息卡同款），不用 80 定宽：
                                     这里输入框是 * 拉伸的，定宽列只会白占横向空间。 -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="保存路径"
                                               FontSize="14"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>

                                    <TextBox x:Name="LogDirectoryTextBox"
                                             Style="{StaticResource FormTextBox}"
                                             Grid.Column="1"
                                             Width="Auto"
                                             HorizontalAlignment="Stretch"
                                             LostFocus="LogDirectoryTextBox_LostFocus"/>

                                    <Button x:Name="LogBrowseButton"
                                            Style="{StaticResource FormButton}"
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Content="浏览…"
                                            Click="LogBrowseButton_Click"/>

                                    <Button x:Name="LogOpenFolderButton"
                                            Style="{StaticResource FormButton}"
                                            Grid.Column="3"
                                            Margin="8,0,0,0"
                                            Content="打开文件夹"
                                            Click="LogOpenFolderButton_Click"/>

                                    <Button x:Name="LogResetDirectoryButton"
                                            Style="{StaticResource FormButton}"
                                            Grid.Column="4"
                                            Margin="8,0,0,0"
                                            Content="恢复默认"
                                            Click="LogResetDirectoryButton_Click"/>
                                </Grid>

                                <!-- 写入失败提示：正常时整行隐藏（Collapsed 不占位），
                                     仅失败时由 RefreshLogSaveStatus 显示琥珀色原因 -->
                                <TextBlock x:Name="LogSaveStatusText"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- 项目信息（P5-3） -->
                        <Border Background="{DynamicResource Brush.Card.Background}"
                                BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1"
                                CornerRadius="8" Padding="24,20,24,20" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="项目信息"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"/>

                                <!-- 两列：左标签固定宽，右值左对齐；行距 8（末行不留底边距） -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabel"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="名称"
                                               FontSize="12" Margin="0,0,16,8"
                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <TextBlock x:Name="InfoProductText" Grid.Row="0" Grid.Column="1"
                                               FontSize="12" Margin="0,0,0,8"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="版本"
                                               FontSize="12" Margin="0,0,16,8"
                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <TextBlock x:Name="InfoVersionText" Grid.Row="1" Grid.Column="1"
                                               FontSize="12" Margin="0,0,0,8"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="构建日期"
                                               FontSize="12" Margin="0,0,16,8"
                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <TextBlock x:Name="InfoBuildDateText" Grid.Row="2" Grid.Column="1"
                                               FontSize="12" Margin="0,0,0,8"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="运行环境"
                                               FontSize="12" Margin="0,0,16,0"
                                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <TextBlock x:Name="InfoRuntimeText" Grid.Row="3" Grid.Column="1"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>            </ScrollViewer>

            <!-- ================= 底栏：全局连接状态（三个页面都可见） =================
                 实现方式：底部对齐 + 内容区下边距 30 让位 —— 不新增行、不改左侧导航列任何属性。
                 跨两列 + 左缩进 112，使底栏左端与内容区左边界对齐（导航列止于 112）；
                 栏内文字向底栏自身两侧对齐（内边距 16），不跟随日志卡片缩进 -->
            <Border Grid.ColumnSpan="2" Margin="112,0,0,0"
                    Height="30" VerticalAlignment="Bottom"
                    Background="{DynamicResource Brush.StatusBar.Background}"
                    BorderBrush="{DynamicResource Brush.StatusBar.Border}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0,16,0">
                    <!-- 左：状态点 + 状态文字（含重连倒计时） -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot"
                                 Width="9" Height="9"
                                 Fill="{DynamicResource Brush.Indicator.Off}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText"
                                   Text="未连接"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 右：连接参数（驱动 / 连接方式 / 协议 / IP:端口） -->
                    <TextBlock x:Name="StatusBarDetail"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Faint}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
