<Project Sdk="Microsoft.NET.Sdk">

  <!-- P3-3 数据模型层的离线验证（黄金样本）。
       直接编译 Modeling 下的源文件，验证的就是应用真正用的那份代码，
       不复制「测试专用实现」，否则测过的东西可能和发布的不是同一个。

       用 EnableDefaultCompileItems=false 显式列出源文件：
       默认 glob 会把子目录 live\ 也包含进来，而那边是另一个独立入口点，
       会导致「只有一个编译单元可具有顶级语句」。
       （DefaultItemExcludes 对 Compile 的默认 glob 不起作用，已实测。）

       不进 .sln；用 dotnet run 加项目路径单独跑。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModelingCheck</RootNamespace>
    <AssemblyName>ModelingCheck</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\DataTypes.cs" Link="DataTypes.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\ValueCodec.cs" Link="ValueCodec.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\ByteOrderSettings.cs" Link="ByteOrderSettings.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\DataPoint.cs" Link="DataPoint.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Drivers\CommDriver.cs" Link="CommDriver.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Drivers\DriverRegistry.cs" Link="DriverRegistry.cs" />
    <!-- P7.1 变量名补全的纯逻辑：候选怎么算在这里，怎么画在 Ui/CompletionPopup.cs（不链接）。 -->
    <Compile Include="..\DSH_Modbus采集工具\Modeling\SystemVariable.cs" Link="SystemVariable.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\GlobalVariable.cs" Link="GlobalVariable.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\CompletionSource.cs" Link="CompletionSource.cs" />
    <!-- P1.2 状态机采集全局变量：读计划与回填的纯逻辑（不链接 Ui/ 下的显示部分）。 -->
    <Compile Include="..\DSH_Modbus采集工具\Modeling\GlobalReadPlan.cs" Link="GlobalReadPlan.cs" />
    <!-- CSV 读写的纯逻辑：SplitRecords / ParseLine / FormatLine / FormatField。
         2026-11-06 加：跨行字段（STRING 里含 0x0A）的切行回归断言需要它。 -->
    <Compile Include="..\DSH_Modbus采集工具\Modeling\AcquisitionCsv.cs" Link="AcquisitionCsv.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\AcquisitionTask.cs" Link="AcquisitionTask.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\AcquisitionConstant.cs" Link="AcquisitionConstant.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\AcquisitionTaskCheck.cs" Link="AcquisitionTaskCheck.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\AcquisitionSource.cs" Link="AcquisitionSource.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\WritePlan.cs" Link="WritePlan.cs" />
    <!-- 表达式引擎：AcquisitionCsv / AcquisitionTaskCheck 引用 CompiledExpression。 -->
    <Compile Include="..\DSH_Modbus采集工具\Expressions\ExpressionValue.cs" Link="ExpressionValue.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Expressions\ExpressionLexer.cs" Link="ExpressionLexer.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Expressions\ExpressionNode.cs" Link="ExpressionNode.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Expressions\ExpressionParser.cs" Link="ExpressionParser.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Expressions\CompiledExpression.cs" Link="CompiledExpression.cs" />
  </ItemGroup>

</Project>
