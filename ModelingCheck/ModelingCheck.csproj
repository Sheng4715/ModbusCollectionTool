<Project Sdk="Microsoft.NET.Sdk">

  <!-- P3-3 数据模型层的离线验证（黄金样本）。
       直接编译 Modeling 下的源文件，验证的就是应用真正用的那份代码，
       不复制「测试专用实现」，否则测过的东西可能和发布的不是同一个。

       用 EnableDefaultCompileItems=false 显式列出源文件：
       默认 glob 会把子目录 live\ 也包含进来，而那边是另一个独立入口点，
       会导致「只有一个编译单元可具有顶级语句」。
       （DefaultItemExcludes 对 Compile 的默认 glob 不起作用，已实测。）

       不进 .sln；用 dotnet run 加项目路径单独跑。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModelingCheck</RootNamespace>
    <AssemblyName>ModelingCheck</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\DataTypes.cs" Link="DataTypes.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\ValueCodec.cs" Link="ValueCodec.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Modeling\DataPoint.cs" Link="DataPoint.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Drivers\CommDriver.cs" Link="CommDriver.cs" />
    <Compile Include="..\DSH_Modbus采集工具\Drivers\DriverRegistry.cs" Link="DriverRegistry.cs" />
  </ItemGroup>

</Project>
