<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DSH_Modbus采集工具</RootNamespace>
    <AssemblyName>DSH_Modbus采集工具</AssemblyName>
  </PropertyGroup>

  <!--
    项目信息（P5-3）。
    版本号**手写**在这里：自动递增看似省事，但会把「版本号」变成构建次数的函数，
    而现场排障需要的是「这个 exe 是哪一版」，不是「编译过几次」。提版本由人决定。

    构建日期相反 —— 手写必然忘记更新，故由 MSBuild 在每次编译时现取写入一个
    生成常量（见下方 WriteBuildDate）。

    版本号拆成 prefix + 可选的 suffix（两者由 SDK 合成 <Version>）：
      数字部分 VersionPrefix 手写，提版本只改这一处；
      suffix 由**构建配置**决定 —— Debug 自动带 -debug。
    这样「哪一版」和「是不是调试版」都能一眼看出，且不必靠人记得改
    （与构建日期同理：能推导的就别手写）。Release 下 suffix 为空，
    版本即干净的 1.0.0。
  -->
  <PropertyGroup>
    <VersionPrefix>1.0.2</VersionPrefix>
    <VersionSuffix Condition="'$(Configuration)' == 'Debug'">debug</VersionSuffix>
    <!-- AssemblyVersion / FileVersion 固定不带 suffix：程序集身份必须稳定，
         否则每换一次配置都会让引用方全部重编（与上面 WriteBuildDate 同一考虑）。 -->
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <Product>DSH Modbus 采集工具</Product>
    <Company>DSH</Company>
    <Description>基于 WPF / .NET 8 的 Modbus 数据采集上位机</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <!--
    构建日期：生成到 obj/ 下的一个源文件里，随项目一起编译。
    用 BeforeTargets="CoreCompile" 而不是覆盖 <Version>：后者会连带影响程序集版本，
    且每次编译都变会让增量构建失效（程序集版本变了，引用它的东西全部重编）。
    这里只产出一个只读常量，与程序集身份无关。
  -->
  <Target Name="WriteBuildDate" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_BuildDateFile>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildDateFile>
      <_BuildDateValue>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))</_BuildDateValue>
    </PropertyGroup>
    <ItemGroup>
      <_BuildInfoLines Include="// &lt;auto-generated&gt; 由 csproj 的 WriteBuildDate 目标生成，请勿手改。" />
      <_BuildInfoLines Include="namespace DSH_Modbus采集工具" />
      <_BuildInfoLines Include="{" />
      <_BuildInfoLines Include="    internal static partial class BuildInfo" />
      <_BuildInfoLines Include="    {" />
      <_BuildInfoLines Include="        public const string BuildDate = &quot;$(_BuildDateValue)&quot;%3B" />
      <_BuildInfoLines Include="    }" />
      <_BuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_BuildDateFile)" Lines="@(_BuildInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_BuildDateFile)" />
      <FileWrites Include="$(_BuildDateFile)" />
    </ItemGroup>
  </Target>

</Project>
