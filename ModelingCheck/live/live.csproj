<Project Sdk="Microsoft.NET.Sdk">

  <!-- 端到端真机验证：用数据模型层的代码直连 PLC，确认解出的值与
       用户在 XDPPro 里写的完全一致。

       与 ModelingCheck 分开成两个工程的原因：两边都是顶层语句（各有一个入口点），
       同一个工程里放两个 Main 会编译失败。故各建一个，都用 Link 引用同一份源文件。

       源文件一律「链接引用」而非拷贝 —— 拷贝会出现「改了应用代码但忘了同步副本，
       验证因此失真」的隐患，那样测过的东西就不是真正发布的东西了。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LiveCheck</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LiveVerification.cs" />
    <Compile Include="..\..\DSH_Modbus采集工具\Modeling\DataTypes.cs" Link="DataTypes.cs" />
    <Compile Include="..\..\DSH_Modbus采集工具\Modeling\ValueCodec.cs" Link="ValueCodec.cs" />
    <Compile Include="..\..\DSH_Modbus采集工具\Modeling\ByteOrderSettings.cs" Link="ByteOrderSettings.cs" />
    <Compile Include="..\..\DSH_Modbus采集工具\Modeling\DataPoint.cs" Link="DataPoint.cs" />
    <Compile Include="..\..\DSH_Modbus采集工具\Drivers\CommDriver.cs" Link="CommDriver.cs" />
    <Compile Include="..\..\DSH_Modbus采集工具\Drivers\DriverRegistry.cs" Link="DriverRegistry.cs" />
      <Compile Include="..\..\DSH_Modbus采集工具\Modeling\AtomicFile.cs" Link="AtomicFile.cs" />
  </ItemGroup>

</Project>
