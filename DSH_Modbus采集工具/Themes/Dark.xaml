<!--
    深色主题。

    键与 Light.xaml **一一对应**（ThemeManager 会校验，缺键直接抛异常）。

    取值原则：
    - **表面色**：比浅色整体压暗，层级关系保持（窗口最暗 < 标题栏/底栏 < 卡片 < 卡片内的块）。
    - **文字色**：不是简单反相 —— 深底上纯白 (#FFF) 会「发光」刺眼，正文用 #F0F0F0；
      越次要的文字越暗，与浅色主题的「越次要越浅」方向相反但层级一致。
    - **半透明叠加**：浅色压黑、深色压白。这是它必须走主题的原因 ——
      同一个黑色叠加在深底上完全看不见。
    - **实底填充（*.Fill）**：深浅两套**同值**。它们承载白字，本身已经是深饱和色，
      在深色主题里同样成立；若跟着提亮，白字就会糊掉。
    - **IO 灯色**：点亮色提亮（深底上 #0B7A0B 太暗，看不清「亮」），
      熄灭色压暗（深底上 #C4C4C4 反而像亮着）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 表面 ================= -->

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Brush.Card.Background" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Brush.Card.Border" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.Chip.Background" Color="#333333"/>
    <SolidColorBrush x:Key="Brush.Subtle.Background" Color="#333333"/>
    <SolidColorBrush x:Key="Brush.Subtle.Border" Color="#3F3F3F"/>

    <SolidColorBrush x:Key="Brush.TitleBar.Background" Color="#262626"/>
    <SolidColorBrush x:Key="Brush.TitleBar.Border" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.TitleBar.Hover" Color="#383838"/>
    <SolidColorBrush x:Key="Brush.StatusBar.Background" Color="#262626"/>
    <SolidColorBrush x:Key="Brush.StatusBar.Border" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.Nav.Border" Color="#3A3A3A"/>

    <!-- ================= PLC 状态机画布 ================= -->

    <SolidColorBrush x:Key="Brush.MachineState.Container" Color="#242424"/>
    <SolidColorBrush x:Key="Brush.MachineState.Container.Border" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.MachineState.Inactive" Color="#474747"/>
    <SolidColorBrush x:Key="Brush.MachineState.Inactive.Border" Color="#5E5E5E"/>
    <SolidColorBrush x:Key="Brush.MachineState.Inactive.Text" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="Brush.MachineState.Line" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="Brush.MachineState.Label" Color="#C8C8C8"/>

    <!-- ================= 文字 ================= -->

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="Brush.Text.Faint" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled.Soft" Color="#6A6A6A"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled.Faint" Color="#757575"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF"/>

    <!-- ================= 交互控件 ================= -->

    <SolidColorBrush x:Key="Brush.Control.Background" Color="#383838"/>
    <SolidColorBrush x:Key="Brush.Control.Hover" Color="#454545"/>
    <SolidColorBrush x:Key="Brush.Control.Pressed" Color="#505050"/>
    <SolidColorBrush x:Key="Brush.Control.Selected" Color="#4A4A4A"/>

    <SolidColorBrush x:Key="Brush.Input.Background" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Brush.Input.Background.Disabled" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Brush.Input.Border" Color="#555555"/>
    <SolidColorBrush x:Key="Brush.Input.Border.Hover" Color="#6A6A6A"/>

    <SolidColorBrush x:Key="Brush.Popup.Background" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Brush.Popup.Border" Color="#4A4A4A"/>

    <SolidColorBrush x:Key="Brush.ScrollBar.Thumb" Color="#555555"/>

    <!-- ================= 半透明叠加（深色压白） ================= -->
    <SolidColorBrush x:Key="Brush.Overlay.Subtle" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Overlay.Medium" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Overlay.Strong" Color="#29FFFFFF"/>

    <!-- ================= 语义色 ================= -->

    <!-- 深底上 #0067C0 太暗，前景/边框提亮；实底填充保持原值以便承载白字 -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#4CA3E0"/>
    <SolidColorBrush x:Key="Brush.Accent.Fill" Color="#0067C0"/>
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#1E3A52"/>

    <SolidColorBrush x:Key="Brush.Danger" Color="#FF6B5E"/>
    <SolidColorBrush x:Key="Brush.Danger.Fill" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Brush.Danger.Fill.Hover" Color="#E81123"/>
    <SolidColorBrush x:Key="Brush.Danger.Fill.Pressed" Color="#B12A1C"/>
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="#4A2020"/>

    <SolidColorBrush x:Key="Brush.Warning" Color="#E0A030"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#4EC94E"/>
    <SolidColorBrush x:Key="Brush.Indicator.Off" Color="#8A8A8A"/>

    <!-- ================= IO 灯色 ================= -->
    <SolidColorBrush x:Key="Io.Input.On" Color="#4EC94E"/>
    <SolidColorBrush x:Key="Io.Output.On" Color="#FFA500"/>
    <SolidColorBrush x:Key="Io.Off" Color="#5A5A5A"/>

</ResourceDictionary>
