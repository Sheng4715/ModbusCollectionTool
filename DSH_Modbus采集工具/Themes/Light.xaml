<!--
    浅色主题（默认）。

    ⚠️ 这里的色值**就是主题化之前 MainWindow.xaml 里的字面量**，逐个搬过来的，
    浅色外观与改造前完全一致。改这里的值 = 改浅色外观，请确认是有意为之。

    深色对应值见 Dark.xaml —— 两个文件的键**必须一一对应**，
    增删键时两边同时改（ThemeManager 会校验键集合是否一致，不一致直接抛异常）。

    命名按**角色**而不是按色值：新增控件时先想「这是哪一类」，
    再挑键；不要因为「颜色看着差不多」就复用别的键。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 表面 ================= -->

    <!-- 窗口最底层背景 -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#F3F3F3"/>
    <!-- 窗口边缘线颜色（由 DWM 绘制，见 Ui/WindowCorners.cs；改这里换主题时自动生效） -->
    <SolidColorBrush x:Key="Brush.Window.Border" Color="#C8C8C8"/>
    <!-- 卡片（白底 + 细边框圆角 8） -->
    <SolidColorBrush x:Key="Brush.Card.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Card.Border" Color="#E8E8E8"/>
    <!-- 卡片内的 1px 分隔线（当作 Background 用的细 Border） -->
    <SolidColorBrush x:Key="Brush.Divider" Color="#E8E8E8"/>
    <!-- 卡片内的浅色小块（地址表元件 chip） -->
    <SolidColorBrush x:Key="Brush.Chip.Background" Color="#F3F3F3"/>
    <!-- IO 点位单元格（比卡片略深一点点） -->
    <SolidColorBrush x:Key="Brush.Subtle.Background" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Brush.Subtle.Border" Color="#EEEEEE"/>
    <!-- 采集数据：任务组展开后的数据项子表。
         比卡片(#FFFFFF)深一档 —— 用户要求「一眼看出这些行属于哪个任务组」，
         光靠缩进不够，得有一块**成块**的底色把子表框起来。 -->
    <SolidColorBrush x:Key="Brush.Acquisition.SubTable.Background" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="Brush.Acquisition.SubTable.Border" Color="#E0E0E0"/>

    <!-- 标题栏 / 底栏 -->
    <SolidColorBrush x:Key="Brush.TitleBar.Background" Color="#E7E7E7"/>
    <SolidColorBrush x:Key="Brush.TitleBar.Border" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="Brush.TitleBar.Hover" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Brush.StatusBar.Background" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Brush.StatusBar.Border" Color="#DCDCDC"/>
    <!-- 左侧导航右边框 + 导航底部斜线 -->
    <SolidColorBrush x:Key="Brush.Nav.Border" Color="#E5E5E5"/>

    <!-- ================= PLC 状态机画布 ================= -->

    <!-- 灰底容器（把中间那 6 个状态框在一起） -->
    <SolidColorBrush x:Key="Brush.MachineState.Container" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="Brush.MachineState.Container.Border" Color="#D6D6D6"/>
    <!-- 值为 0 时的状态框：浅灰，与「点亮」形成对比 -->
    <SolidColorBrush x:Key="Brush.MachineState.Inactive" Color="#E9E9E9"/>
    <SolidColorBrush x:Key="Brush.MachineState.Inactive.Border" Color="#C4C4C4"/>
    <SolidColorBrush x:Key="Brush.MachineState.Inactive.Text" Color="#969696"/>
    <!-- 转移连线与连线上的文字 -->
    <SolidColorBrush x:Key="Brush.MachineState.Line" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="Brush.MachineState.Label" Color="#3C3C3C"/>

    <!-- ================= 文字 ================= -->

    <!-- 正文 / 标题 -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1A1A1A"/>
    <!-- 次要说明文字 -->
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#5D5D5D"/>
    <!-- 更弱一档：下拉框 chevron、底栏右侧参数 -->
    <SolidColorBrush x:Key="Brush.Text.Faint" Color="#6A6A6A"/>
    <!-- 表头文字、默认态图标按钮 -->
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#8A8A8A"/>
    <!-- 提示语 / 日志时间戳 / 禁用输入框文字 / 状态点熄灭 -->
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#9A9A9A"/>
    <!-- 禁用态前景：分页箭头/文字按钮用 #C0C0C0，图标按钮用 #C8C8C8，下拉框用 #B0B0B0。
         主题化之前这三档就是不同的字面值，此处原样保留 —— 合并成一个会被看出差别。 -->
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled.Soft" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Brush.Text.Disabled.Faint" Color="#C8C8C8"/>
    <!-- 压在主色/危险色实底上的文字 -->
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF"/>

    <!-- ================= 交互控件 ================= -->

    <!-- 灰底胶囊（按钮、下拉框、分段切换轨道） -->
    <SolidColorBrush x:Key="Brush.Control.Background" Color="#EDEDED"/>
    <SolidColorBrush x:Key="Brush.Control.Hover" Color="#E2E2E2"/>
    <SolidColorBrush x:Key="Brush.Control.Pressed" Color="#D9D9D9"/>
    <!-- 分段切换的选中态（白底浮起） -->
    <SolidColorBrush x:Key="Brush.Control.Selected" Color="#FFFFFF"/>

    <!-- 输入框：白底描边 -->
    <SolidColorBrush x:Key="Brush.Input.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Input.Background.Disabled" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Brush.Input.Border" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="Brush.Input.Border.Hover" Color="#9A9A9A"/>

    <!-- 下拉弹层 -->
    <SolidColorBrush x:Key="Brush.Popup.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Popup.Border" Color="#D6D6D6"/>

    <!-- 悬停提示（ToolTip）。
         ⚠️ WPF 的 ToolTip 默认模板**完全不吃主题**：深色主题下会是一块浅色白板，
         与整窗深色底对比刺眼（实测截图可见）。故必须有隐式 Style 覆盖它。 -->
    <SolidColorBrush x:Key="Brush.ToolTip.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ToolTip.Border" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="Brush.ToolTip.Foreground" Color="#1A1A1A"/>

    <SolidColorBrush x:Key="Brush.ScrollBar.Thumb" Color="#C4C4C4"/>

    <!-- ================= 半透明叠加 =================
         压在**任意底色**上的微叠加（导航悬停/选中/按下、滚动条悬停）。
         浅色用黑、深色用白 —— 这正是它们必须走主题的原因。 -->
    <SolidColorBrush x:Key="Brush.Overlay.Subtle" Color="#0A000000"/>
    <SolidColorBrush x:Key="Brush.Overlay.Medium" Color="#0D000000"/>
    <SolidColorBrush x:Key="Brush.Overlay.Strong" Color="#12000000"/>

    <!-- ================= 语义色 =================
         前景/边框用（压在浅底上）；实底填充另见 *.Fill（其上压白字，深浅两套同值） -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#0067C0"/>
    <SolidColorBrush x:Key="Brush.Accent.Fill" Color="#0067C0"/>
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#DCE9F7"/>

    <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Brush.Danger.Fill" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Brush.Danger.Fill.Hover" Color="#E81123"/>
    <SolidColorBrush x:Key="Brush.Danger.Fill.Pressed" Color="#B12A1C"/>
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="#FDE7E9"/>

    <SolidColorBrush x:Key="Brush.Warning" Color="#B26A00"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#0B7A0B"/>
    <!-- 状态点「未连接」 -->
    <SolidColorBrush x:Key="Brush.Indicator.Off" Color="#9A9A9A"/>

    <!-- ================= IO 灯色 =================
         这三支在 MainWindow.xaml.cs 的 IoPoint 里取用（C# 侧），
         键名不带 Brush. 前缀以示区分。 -->
    <SolidColorBrush x:Key="Io.Input.On" Color="#0B7A0B"/>
    <SolidColorBrush x:Key="Io.Output.On" Color="#FFA500"/>
    <SolidColorBrush x:Key="Io.Off" Color="#C4C4C4"/>

</ResourceDictionary>
