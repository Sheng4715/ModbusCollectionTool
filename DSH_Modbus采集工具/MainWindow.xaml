<Window x:Class="DSH_Modbus采集工具.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Microsoft Store"
        Height="640" Width="1024"
        MinHeight="640" MinWidth="1024"
        Background="#F3F3F3"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        FontSize="14"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- 标题栏按钮 -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D9D9D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B12A1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧导航（NavigationView 风格，带指示条） -->
        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="Checked" Handler="Nav_Checked"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Backplate"
                                Height="40" Margin="8,2" Padding="14,0"
                                CornerRadius="4"
                                Background="Transparent"
                                HorizontalAlignment="Stretch">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Backplate" Property="Background" Value="#0A000000"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Backplate" Property="Background" Value="#0D000000"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Backplate" Property="Background" Value="#12000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IO 元件区分段切换（输入X / 输出Y）：灰底胶囊轨道 + 选中白底浮起 -->
        <Style x:Key="IoSegmentRadioButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#5D5D5D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBd"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBd" Property="Background" Value="#E2E2E2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBd" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#1A1A1A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IO 点位项模板 -->
        <DataTemplate x:Key="IoItemTemplate">
            <Border Height="22" Padding="3,0" Margin="0,0,0,2"
                    Background="#FAFAFA" BorderBrush="#EEEEEE"
                    BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="10" Height="10" CornerRadius="5"
                            Background="{Binding StateBrush}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#1A1A1A"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Comment}"
                               MinWidth="144"
                               FontSize="12"
                               Foreground="#5D5D5D"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Comment}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- IO 列内条目横向拉伸 -->
        <Style x:Key="IoItemsControlStyle" TargetType="ItemsControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C4C4C4" CornerRadius="4" Margin="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="MinWidth" Value="0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 标题栏 ================= -->
        <Border Grid.Row="0" Background="#E7E7E7" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           Foreground="#0067C0" VerticalAlignment="Center"/>
                    <TextBlock Text="数据采集Demo" FontSize="13" Foreground="#1A1A1A"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右侧：窗口按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click"
                        Content="&#xE921;" ToolTip="最小化"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                        Click="MaximizeButton_Click" Content="&#xE922;" ToolTip="最大化"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="CloseButton_Click"
                        Content="&#xE8BB;" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="Transparent"
                    BorderBrush="#E5E5E5" BorderThickness="0,0,1,0" Margin="0,0,112,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                        <RadioButton x:Name="OverviewNav"
                                     Style="{StaticResource NavRadioButton}" GroupName="Nav" IsChecked="True"
                                     Content="总览"/>
                        <RadioButton x:Name="StatusInfoNav"
                                     Style="{StaticResource NavRadioButton}" GroupName="Nav"
                                     Content="状态信息"/>
                        <RadioButton Style="{StaticResource NavRadioButton}" GroupName="Nav"
                                     Content="采集配置" Checked="RadioButton_Checked"/>
                        <RadioButton x:Name="DeviceConfigNav"
                                     Style="{StaticResource NavRadioButton}" GroupName="Nav"
                                     Content="设备配置"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                        <Separator Background="#E5E5E5" BorderThickness="0" Margin="16,4,16,8"/>
                        <RadioButton Style="{StaticResource NavRadioButton}" GroupName="Nav"
                                     Content="设置"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 内容区（商店内容已移除，留空待填充） -->
            <ScrollViewer
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="36,4,36,16" Grid.ColumnSpan="2" Margin="112,0,0,0">
                <StackPanel>

                    <!-- 总览 -->
                    <StackPanel x:Name="OverviewPanel" d:Visibility="Collapsed">
                        <TextBlock Text="总览"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="20" FontWeight="SemiBold" Foreground="#1A1A1A"
                                   Margin="0,16,0,16"/>

                        <Border Background="#FFFFFF"
                                BorderBrush="#E8E8E8" BorderThickness="1"
                                CornerRadius="8" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1"
                                           x:Name="OverviewStatusText"
                                           FontSize="14"
                                           Foreground="#1A1A1A"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left">
                                    <Run x:Name="OverviewStatusPrefix" Text="信捷XD/XL系列：以太网  ModbusTCP  192.168.1.100:502"/>
                                </TextBlock>
                                <TextBlock Grid.Column="2"
                                           x:Name="OverviewStatusState"
                                           Text="未连接"
                                           FontSize="14"
                                           Foreground="#C08A00"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 状态信息 / IO 监控 -->
                    <StackPanel x:Name="StatusInfoPanel" Visibility="Collapsed" d:Visibility="Visible">
                        <TextBlock Text="状态信息"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="20" FontWeight="SemiBold" Foreground="#1A1A1A"
                                   Margin="0,8,0,10"/>

                        <Border Background="#FFFFFF"
                                BorderBrush="#E8E8E8" BorderThickness="1"
                                CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <!-- 元件区快速切换：输入监控(X) / 输出监控(Y) -->
                                        <Border Background="#EDEDED" CornerRadius="6" Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="XViewSegment"
                                                             Content="输入监控"
                                                             GroupName="IoView"
                                                             IsChecked="True"
                                                             Style="{StaticResource IoSegmentRadioButton}"
                                                             Checked="IoView_Checked"/>
                                                <RadioButton x:Name="YViewSegment"
                                                             Content="输出监控"
                                                             GroupName="IoView"
                                                             Style="{StaticResource IoSegmentRadioButton}"
                                                             Checked="IoView_Checked"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- 导入 IO 点位表（xlsx，替换注释） -->
                                        <Button x:Name="ImportIoTableButton"
                                                Content="导入 IO 表"
                                                Margin="8,0,0,0"
                                                Padding="10,5"
                                                FontSize="12"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Click="ImportIoTableButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 输入监控（X0–X77） -->
                                <Grid x:Name="IoColumnsGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ItemsControl x:Name="IoColumn0" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="IoColumn1" Grid.Column="1" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="IoColumn2" Grid.Column="2" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="IoColumn3" Grid.Column="3"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                </Grid>

                                <!-- 输出监控（Y0–Y77，默认隐藏） -->
                                <Grid x:Name="YIoColumnsGrid" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ItemsControl x:Name="YIoColumn0" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="YIoColumn1" Grid.Column="1" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="YIoColumn2" Grid.Column="2" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="YIoColumn3" Grid.Column="3"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 设备配置 -->
                    <StackPanel x:Name="DeviceConfigPanel"
                                 Visibility="Collapsed"
                                 d:Visibility="Collapsed">
                        <TextBlock Text="设备配置"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="20" FontWeight="SemiBold" Foreground="#1A1A1A"
                                   Margin="0,16,0,16"/>

                        <Border Background="#FFFFFF"
                                BorderBrush="#E8E8E8" BorderThickness="1"
                                CornerRadius="8" Padding="20">
                            <StackPanel>

                                <!-- 连接方式 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="连接方式"
                                               Width="80"
                                               FontSize="14" Foreground="#1A1A1A"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ConnectionTypeComboBox"
                                              Width="220"
                                              VerticalAlignment="Center"
                                              SelectedIndex="0"
                                              SelectionChanged="ConnectionTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="以太网"/>
                                        <ComboBoxItem Content="串口"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 协议类型 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="协议类型"
                                               Width="80"
                                               FontSize="14" Foreground="#1A1A1A"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ProtocolTypeComboBox"
                                              Width="220"
                                              VerticalAlignment="Center"
                                              SelectedIndex="0"
                                              SelectionChanged="ProtocolTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="ModbusTCP"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 设备类型 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="设备类型"
                                               Width="80"
                                               FontSize="14" Foreground="#1A1A1A"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="DeviceTypeComboBox"
                                              Width="220"
                                              VerticalAlignment="Center"
                                              SelectionChanged="DeviceTypeComboBox_SelectionChanged"/>
                                </StackPanel>

                                <!-- 采集周期 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="采集周期"
                                               Width="80"
                                               FontSize="14" Foreground="#1A1A1A"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="PollIntervalComboBox"
                                              Width="220"
                                              VerticalAlignment="Center"
                                              SelectedIndex="0"
                                              SelectionChanged="PollIntervalComboBox_SelectionChanged">
                                        <ComboBoxItem Content="100 ms" Tag="100"/>
                                        <ComboBoxItem Content="200 ms" Tag="200"/>
                                        <ComboBoxItem Content="500 ms" Tag="500"/>
                                        <ComboBoxItem Content="1 s" Tag="1000"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 以太网专属选项 -->
                                <StackPanel x:Name="EthernetOptionsPanel">

                                    <!-- 目标网卡 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="目标网卡"
                                                   Width="80"
                                                   FontSize="14" Foreground="#1A1A1A"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox x:Name="TargetNicComboBox"
                                                  Width="220"
                                                  VerticalAlignment="Center"/>
                                        <Button x:Name="RefreshNicButton"
                                                Content="刷新"
                                                Width="60" Height="{Binding ActualHeight, ElementName=TargetNicComboBox}"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                Click="RefreshNicButton_Click"/>
                                    </StackPanel>

                                    <!-- IP -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="IP地址
                                                   "
                                                   Width="80"
                                                   FontSize="14" Foreground="#1A1A1A"
                                                   VerticalAlignment="Center"/>
                                        <TextBox x:Name="IpTextBox"
                                                 Width="220"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Padding="8,0"
                                                 FontSize="13"
                                                 Text="192.168.1.100"
                                                 TextChanged="ConfigInput_TextChanged"/>
                                        <Button x:Name="ConnectButton"
                                                Content="连接"
                                                Width="60"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                Click="ConnectButton_Click"/>
                                        <Ellipse x:Name="StatusDot"
                                                 Width="10" Height="10"
                                                 Fill="#9A9A9A"
                                                 Margin="16,0,0,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StatusText"
                                                   Text="未连接"
                                                   FontSize="13"
                                                   Foreground="#5D5D5D"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- 端口号 -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="端口号"
                                                   Width="80"
                                                   FontSize="14" Foreground="#1A1A1A"
                                                   VerticalAlignment="Center"/>
                                        <TextBox x:Name="PortTextBox"
                                                 Width="220"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Padding="8,0"
                                                 FontSize="13"
                                                 Text="502"
                                                 TextChanged="ConfigInput_TextChanged"/>
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
