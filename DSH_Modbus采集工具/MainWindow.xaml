<Window x:Class="DSH_Modbus采集工具.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DSH_Modbus采集工具"
        mc:Ignorable="d"
        Title="采集工具"
        Height="640" Width="1024"
        MinHeight="640" MinWidth="1024"
        Background="#F3F3F3"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        FontSize="14"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- 枚举 → 大写名（显示格式 BIN/DEC/HEX/ASCII） -->
        <local:EnumUpperConverter x:Key="EnumUpperConverter"/>

        <!-- 标题栏按钮 -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D9D9D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B12A1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧导航（NavigationView 风格，带指示条） -->
        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="Checked" Handler="Nav_Checked"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Backplate"
                                Height="40" Margin="8,2" Padding="14,0"
                                CornerRadius="4"
                                Background="Transparent"
                                HorizontalAlignment="Stretch">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Backplate" Property="Background" Value="#0A000000"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Backplate" Property="Background" Value="#0D000000"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Backplate" Property="Background" Value="#12000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IO 元件区分段切换（输入X / 输出Y）：灰底胶囊轨道 + 选中白底浮起 -->
        <Style x:Key="IoSegmentRadioButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#5D5D5D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBd"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBd" Property="Background" Value="#E2E2E2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBd" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#1A1A1A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 地址表元件块（设备配置页：线圈区 / 寄存器区） -->
        <DataTemplate x:Key="AreaChipTemplate">
            <Border Background="#F3F3F3" BorderBrush="#E8E8E8" BorderThickness="1"
                    CornerRadius="4" Padding="8,2" Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    ToolTip="{Binding ToolTipText}">
                <TextBlock Text="{Binding Element}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="#1A1A1A"/>
            </Border>
        </DataTemplate>

        <!-- 地址表元件行：横向排列，不换行 -->
        <Style x:Key="AreaItemsControlStyle" TargetType="ItemsControl">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ItemTemplate" Value="{StaticResource AreaChipTemplate}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IO 分页按钮（卡片右上角 < >） -->
        <Style x:Key="IoPagerButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#5D5D5D"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PagerBd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PagerBd" Property="Background" Value="#E2E2E2"/>
                                <Setter Property="Foreground" Value="#1A1A1A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PagerBd" Property="Background" Value="#D9D9D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#C0C0C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IO 点位项模板 -->
        <DataTemplate x:Key="IoItemTemplate">
            <Border Height="22" Padding="3,0" Margin="0,0,0,2"
                    Background="#FAFAFA" BorderBrush="#EEEEEE"
                    BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="10" Height="10" CornerRadius="5"
                            Background="{Binding StateBrush}"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#1A1A1A"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Comment}"
                               MinWidth="144"
                               FontSize="12"
                               Foreground="#5D5D5D"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Comment}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- IO 列内条目横向拉伸 -->
        <Style x:Key="IoItemsControlStyle" TargetType="ItemsControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 自由监控 ================= -->

        <!-- 行内小按钮（删除 ×） -->
        <Style x:Key="MonitorIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            表头操作列的图标按钮。与行内 MonitorIconButton 的区别是**悬停配色**：
            行内那个是「删除本项」，悬停变红是对的；表头这两个一个是「新增」（加法，
            变红会让人以为点下去是破坏性操作）、一个是「全部删除」（确实是破坏性，
            但和行内的单行删除共用红色会分不清后果轻重）。
            Add 用主色 #0067C0（与聚焦下划线同色，表示「正向操作」），
            ClearAll 用浅红 #FDE7E9 底 + #C42B1C 字（与日志「已断开」同色系），
            都比整块实心红更克制。
        -->
        <Style x:Key="MonitorHeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0067C0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- 无监控项时不可用（全部删除无意义） -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#C8C8C8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 「全部删除」：悬停浅红底 + 深红字，与「新增」的主色底区分破坏性语义 -->
        <Style x:Key="MonitorClearAllButton" TargetType="Button"
               BasedOn="{StaticResource MonitorHeaderIconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FDE7E9"/>
                                <Setter Property="Foreground" Value="#C42B1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#C8C8C8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行内输入框：无边框，聚焦时才显示下划线，避免表格看起来很「重」 -->
        <Style x:Key="MonitorInlineTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#D0D0D0"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0067C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 枚举 → 大写名（显示格式用；BIN/DEC/HEX/ASCII 按惯例全大写） -->
        <DataTemplate x:Key="EnumUpperTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumUpperConverter}}"
                       FontSize="12" Foreground="#1A1A1A"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- 行内下拉框：紧凑，用于类型 / 格式 -->
        <Style x:Key="MonitorInlineComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 自由监控的一行 -->
        <DataTemplate x:Key="MonitorItemTemplate">
            <Border Height="30" Margin="0,0,0,2"
                    Background="Transparent"
                    BorderBrush="#E8E8E8" BorderThickness="0,0,0,1"
                    Loaded="MonitorRow_Loaded"
                    ToolTip="{Binding ToolTipText}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>   <!-- 序号 -->
                        <ColumnDefinition Width="150"/>  <!-- 元件名称（符号+编号，方案 2） -->
                        <ColumnDefinition Width="152"/>  <!-- 数据类型 ↓（+ STRING 长度） -->
                        <ColumnDefinition Width="88"/>   <!-- 显示格式 ↓ -->
                        <ColumnDefinition Width="*"/>    <!-- 当前值 -->
                        <ColumnDefinition Width="40"/>   <!-- 删除 -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Id}"
                               FontSize="12" Foreground="#9A9A9A"
                               VerticalAlignment="Center"/>

                    <!-- 元件名称：符号与编号合并输入（方案 2），如 HD100 / X17；
                         解析失败时本行标红并在 ToolTip 给出原因 -->
                    <TextBox x:Name="NameBox"
                             Grid.Column="1"
                             Style="{StaticResource MonitorInlineTextBox}"
                             Padding="0"
                             TextChanged="MonitorName_TextChanged"
                             LostFocus="MonitorName_LostFocus"
                             ToolTip="{Binding NameToolTip}"/>

                    <ComboBox Grid.Column="2" x:Name="TypeCombo"
                              Width="96"
                              HorizontalAlignment="Left"
                              Style="{StaticResource MonitorInlineComboBox}"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="MonitorType_SelectionChanged"/>

                    <!-- STRING 的长度：仅该类型时显示 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="Collapsed" x:Name="LengthPanel">
                        <TextBlock Text="长" FontSize="11" Foreground="#8A8A8A"
                                   VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBox x:Name="LengthBox"
                                 Width="28"
                                 Style="{StaticResource MonitorInlineTextBox}"
                                 TextChanged="MonitorLength_TextChanged"
                                 ToolTip="字符串字符数 n；占 ⌈n/2⌉ 个连续寄存器"/>
                    </StackPanel>

                    <ComboBox Grid.Column="3" x:Name="FormatCombo"
                              Width="76"
                              HorizontalAlignment="Left"
                              Style="{StaticResource MonitorInlineComboBox}"
                              ItemTemplate="{StaticResource EnumUpperTemplate}"
                              SelectionChanged="MonitorFormat_SelectionChanged"/>

                    <!-- 当前值：本阶段占位，读取链路属下一步 -->
                    <TextBlock Grid.Column="4" Text="{Binding CurrentValue}"
                               FontSize="12"
                               Foreground="{Binding RowBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="5"
                            Content="&#xE711;"
                            ToolTip="删除本项"
                            Style="{StaticResource MonitorIconButton}"
                            Click="RemoveMonitorItem_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 细滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C4C4C4" CornerRadius="4" Margin="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="MinWidth" Value="0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 日志卡「清空」按钮（文字版，沿用 IoPagerButton 的悬停/按下反馈） -->
        <Style x:Key="LogClearButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5D5D5D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LogClearBd" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LogClearBd" Property="Background" Value="#E2E2E2"/>
                                <Setter Property="Foreground" Value="#1A1A1A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LogClearBd" Property="Background" Value="#D9D9D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#C0C0C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设备状态日志行：[时间] 消息；时间固定灰色，消息按级别着色。
             时间列用 SharedSizeGroup 在各行间共享宽度：否则 Auto 会按本行时间戳实际字宽计算，
             而 Segoe UI 数字是比例字宽（1 比 5/8 窄），含 1 的时间戳更窄 → 消息左边界会左右抖动 -->
        <DataTemplate x:Key="DeviceLogItemTemplate">
            <Grid Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DeviceLogTime"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="#9A9A9A"
                           VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12"
                           Foreground="{Binding LevelBrush}"
                           TextWrapping="Wrap" Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- 日志列表：无边框/透明底，去掉条目的选中底色与焦点框（只读展示） -->
        <Style x:Key="DeviceLogListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 标题栏 ================= -->
        <Border Grid.Row="0" Background="#E7E7E7" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           Foreground="#0067C0" VerticalAlignment="Center"/>
                    <TextBlock Text="数据采集Demo" FontSize="13" Foreground="#1A1A1A"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右侧：窗口按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click"
                        Content="&#xE921;" ToolTip="最小化"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                        Click="MaximizeButton_Click" Content="&#xE922;" ToolTip="最大化"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="CloseButton_Click"
                        Content="&#xE8BB;" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="Transparent"
                    BorderBrush="#E5E5E5" BorderThickness="0,0,1,0" Margin="0,0,112,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                        <RadioButton x:Name="OverviewNav"
                                     Style="{StaticResource NavRadioButton}" GroupName="Nav" IsChecked="True"
                                     Content="总览"/>
                        <RadioButton x:Name="StatusInfoNav"
                                     Style="{StaticResource NavRadioButton}" GroupName="Nav"
                                     Content="状态信息"/>
                        <RadioButton Style="{StaticResource NavRadioButton}" GroupName="Nav"
                                     Content="采集配置" Checked="RadioButton_Checked"/>
                        <RadioButton x:Name="DeviceConfigNav"
                                     Style="{StaticResource NavRadioButton}" GroupName="Nav"
                                     Content="设备配置"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                        <Separator Background="#E5E5E5" BorderThickness="0" Margin="16,4,16,8"/>
                        <RadioButton Style="{StaticResource NavRadioButton}" GroupName="Nav"
                                     Content="设置"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 内容区（商店内容已移除，留空待填充）：下边距 30 给底栏让位 -->
            <ScrollViewer x:Name="ContentScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="36,4,36,16" Grid.ColumnSpan="2" Margin="112,0,0,30">
                <StackPanel>

                    <!-- 总览：高度取内容区视口高度，下方 1/4 固定给设备状态日志（贴窗口底部）。
                         设计器只认 d:Visibility，本页为设计器默认预览页（切换见 AGENTS.md） -->
                    <Grid x:Name="OverviewPanel" d:Visibility="Visible"
                          Height="{Binding ViewportHeight, ElementName=ContentScrollViewer}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" VerticalAlignment="Top">
                            <TextBlock Text="总览"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                       FontSize="20" FontWeight="SemiBold" Foreground="#1A1A1A"
                                       Margin="0,16,0,16"/>
                        </StackPanel>

                        <!-- 设备状态日志：只记设备状态（连接/断开/连接失败/心跳告警），空时不显示任何内容 -->
                        <Border Grid.Row="1" Background="#FFFFFF"
                                BorderBrush="#E8E8E8" BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="10,4,10,2">
                                    <TextBlock Text="运行日志"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="ClearDeviceLogButton" Content="清空"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource LogClearButton}"
                                            Click="ClearDeviceLogButton_Click"/>
                                </Grid>
                                <!-- 日志显示区：内嵌框线，与卡片留白区分开 -->
                                <Border Grid.Row="1" Margin="10,0,10,10"
                                        Background="#FFFFFF"
                                        BorderBrush="#E8E8E8" BorderThickness="1"
                                        CornerRadius="4" Padding="8,6,2,6">
                                    <ListBox x:Name="DeviceLogList"
                                             Grid.IsSharedSizeScope="True"
                                             Style="{StaticResource DeviceLogListStyle}"
                                             ItemTemplate="{StaticResource DeviceLogItemTemplate}" d:ItemsSource="{d:SampleData ItemCount=5}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 状态信息 / IO 监控 -->
                    <StackPanel x:Name="StatusInfoPanel" Visibility="Collapsed" d:Visibility="Collapsed">
                        <TextBlock Text="状态信息"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="20" FontWeight="SemiBold" Foreground="#1A1A1A"
                                   Margin="0,8,0,10"/>

                        <Border Background="#FFFFFF"
                                BorderBrush="#E8E8E8" BorderThickness="1"
                                CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <!-- 元件区快速切换：输入监控(X) / 输出监控(Y) -->
                                        <Border Background="#EDEDED" CornerRadius="6" Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="XViewSegment"
                                                             Content="输入监控"
                                                             GroupName="IoView"
                                                             IsChecked="True"
                                                             Style="{StaticResource IoSegmentRadioButton}"
                                                             Checked="IoView_Checked"/>
                                                <RadioButton x:Name="YViewSegment"
                                                             Content="输出监控"
                                                             GroupName="IoView"
                                                             Style="{StaticResource IoSegmentRadioButton}"
                                                             Checked="IoView_Checked"/>
                                                <RadioButton x:Name="FreeViewSegment"
                                                             Content="自由监控"
                                                             GroupName="IoView"
                                                             Style="{StaticResource IoSegmentRadioButton}"
                                                             Checked="IoView_Checked"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- 导入 IO 点位表（xlsx，替换注释） -->
                                        <Button x:Name="ImportIoTableButton"
                                                Content="导入 IO 表"
                                                Margin="8,0,0,0"
                                                Padding="10,5"
                                                FontSize="12"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Click="ImportIoTableButton_Click"/>
                                    </StackPanel>

                                    <!-- 分页（右上角）：本分段超过一页时才显示 -->
                                    <StackPanel x:Name="IoPagerPanel"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                        <Button x:Name="IoPrevPageButton"
                                                Content="&#xE76B;"
                                                ToolTip="上一页"
                                                Style="{StaticResource IoPagerButton}"
                                                Click="IoPrevPageButton_Click"/>
                                        <TextBlock x:Name="IoPageText"
                                                   Text="1/1"
                                                   MinWidth="46"
                                                   TextAlignment="Center"
                                                   FontSize="12" Foreground="#5D5D5D"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="IoNextPageButton"
                                                Content="&#xE76C;"
                                                ToolTip="下一页"
                                                Style="{StaticResource IoPagerButton}"
                                                Click="IoNextPageButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 分隔线：控件行与 IO 点位表格之间 -->
                                <Border Height="1" Background="#E8E8E8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=FreeViewSegment}" Value="True">
                                                    <Setter Property="Margin" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- 输入监控（X0–X77） -->
                                <Grid x:Name="IoColumnsGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ItemsControl x:Name="IoColumn0" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="IoColumn1" Grid.Column="1" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="IoColumn2" Grid.Column="2" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="IoColumn3" Grid.Column="3"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                </Grid>

                                <!-- 输出监控（Y0–Y77，默认隐藏） -->
                                <Grid x:Name="YIoColumnsGrid" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ItemsControl x:Name="YIoColumn0" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="YIoColumn1" Grid.Column="1" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="YIoColumn2" Grid.Column="2" Margin="0,0,4,0"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                    <ItemsControl x:Name="YIoColumn3" Grid.Column="3"
                                                  Style="{StaticResource IoItemsControlStyle}"
                                                  ItemTemplate="{StaticResource IoItemTemplate}"/>
                                </Grid>

                                <!-- ================= 自由监控（默认隐藏） =================
                                     表格式：表头 + 行。元件名称合并输入（方案 2），
                                     按驱动校验元件名，报错给出具体原因。
                                     当前值列本阶段为占位「—」—— 读取链路属下一步。 -->
                                <StackPanel x:Name="FreeMonitorPanel" Visibility="Collapsed">

                                    <!--
                                        表头行。外层 Grid 把「列表头」与「计数 + 全部删除」叠在同一行里，
                                        不必再手工估负边距（那样两边按钮会差几像素），
                                        也不必往列表头里加列（那样会挤窄 `*` 列使「+」错位）。

                                        ⚠️ 垂直几何：表头与数据行都用「Border + 自身下边框」，
                                        而不是「自然高度文本 + 另加一条 Border 分隔线」——
                                        后者文本行高随字体变化，分隔线又带独立 Margin，
                                        结果表头文字既不对齐行内容、也不居中于上下两条线。

                                        ⚠️ 分隔线颜色用 `#E8E8E8`（卡片边框色），**不要用 `#F0F0F0`**：
                                        后者与卡片底色 `#F3F3F3` 只差 3 级，在 150% DPI 下经缩放
                                        混色后几乎看不见，表头就会显得「悬空」。

                                        自由监控时将上分隔线的 8 DIP 下边距并入原 38 DIP 表头，
                                        使文字和按钮在两条线之间居中，同时保持分隔线与数据行位置不变。 -->
                                    <Border x:Name="MonitorHeaderGrid"
                                            Height="46"
                                            Margin="0,0,0,2"
                                            Background="Transparent"
                                            BorderBrush="#E8E8E8"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <!--
                                                列表头（列定义必须与 MonitorItemTemplate 完全一致：
                                                同 6 列、同宽度。多一列会挤窄 `*`，使整条横向错位）。
                                            -->
                                            <Grid x:Name="MonitorHeaderColumns">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>   <!-- 序号 -->
                                                    <ColumnDefinition Width="150"/>  <!-- 元件 -->
                                                    <ColumnDefinition Width="152"/>  <!-- 数据类型（+ STRING 长度） -->
                                                    <ColumnDefinition Width="88"/>   <!-- 显示格式 -->
                                                    <ColumnDefinition Width="*"/>    <!-- 当前值 -->
                                                    <ColumnDefinition Width="40"/>   <!-- 行内删除列（表头留空） -->
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#" FontSize="12" Foreground="#8A8A8A" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="元件名称" FontSize="12" Foreground="#8A8A8A" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="数据类型" FontSize="12" Foreground="#8A8A8A" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="显示格式" FontSize="12" Foreground="#8A8A8A" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="当前值" FontSize="12" Foreground="#8A8A8A" VerticalAlignment="Center"/>
                                                <!-- 第 5 列留空：与行内 × 同列，保留列宽使「当前值」宽度与行一致 -->
                                            </Grid>

                                            <!--
                                                表头操作区：靠右叠放，**不参与**列表头的列布局。
                                                顺序按用户要求：计数 → 🗑 全部删除 → + 新增（+ 在最右）。
                                            -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,0,7,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="MonitorCountText"
                                                           FontSize="12" Foreground="#9A9A9A"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <Button x:Name="ClearMonitorItemsButton"
                                                        Content="&#xE74D;"
                                                        ToolTip="删除全部监控项"
                                                        Style="{StaticResource MonitorClearAllButton}"
                                                        Click="ClearMonitorItems_Click"/>
                                                <Button x:Name="AddMonitorItemButton"
                                                        Content="&#xE710;"
                                                        ToolTip="新增监控项"
                                                        Margin="6,0,0,0"
                                                        Style="{StaticResource MonitorHeaderIconButton}"
                                                        Click="AddMonitorItemButton_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 列表：项多时自身滚动，不吃掉卡片外的高度 -->
                                    <ScrollViewer MaxHeight="380"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="MonitorItemsControl"
                                                      HorizontalContentAlignment="Stretch"
                                                      ItemTemplate="{StaticResource MonitorItemTemplate}">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- 空状态 -->
                                    <TextBlock x:Name="MonitorEmptyHint"
                                               Text="尚未添加监控项，点击右上角 + 添加"
                                               Visibility="Collapsed"
                                               FontSize="12"
                                               Foreground="#9A9A9A"
                                               Margin="0,10,0,6"/>
                                </StackPanel>

                                <!-- 空状态占位：未导入 IO 表 / 本分段无点位时显示 -->
                                <TextBlock x:Name="IoEmptyHint"
                                           Text="尚未导入 IO 表"
                                           Visibility="Collapsed"
                                           FontSize="12"
                                           Foreground="#9A9A9A"
                                           Margin="0,6,0,4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 设备配置 -->
                    <StackPanel x:Name="DeviceConfigPanel"
                                 Visibility="Collapsed"
                                 d:Visibility="Collapsed">
                        <TextBlock Text="设备配置"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="20" FontWeight="SemiBold" Foreground="#1A1A1A"
                                   Margin="0,16,0,16"/>

                        <Border Background="#FFFFFF"
                                BorderBrush="#E8E8E8" BorderThickness="1"
                                CornerRadius="8" Padding="20">
                            <StackPanel>

                                <!-- 连接方式 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="连接方式"
                                               Width="80"
                                               FontSize="14" Foreground="#1A1A1A"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ConnectionTypeComboBox"
                                              Width="200"
                                              VerticalAlignment="Center"
                                              SelectedIndex="0"
                                              SelectionChanged="ConnectionTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="以太网"/>
                                        <ComboBoxItem Content="串口"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 协议类型 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="协议类型"
                                               Width="80"
                                               FontSize="14" Foreground="#1A1A1A"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ProtocolTypeComboBox"
                                              Width="200"
                                              VerticalAlignment="Center"
                                              SelectedIndex="0"
                                              SelectionChanged="ProtocolTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="ModbusTCP"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 设备类型 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="设备类型"
                                               Width="80"
                                               FontSize="14" Foreground="#1A1A1A"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="DeviceTypeComboBox"
                                              Width="200"
                                              VerticalAlignment="Center"
                                              SelectionChanged="DeviceTypeComboBox_SelectionChanged"/>
                                </StackPanel>

                                <!-- 采集周期 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="采集周期"
                                               Width="80"
                                               FontSize="14" Foreground="#1A1A1A"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="PollIntervalComboBox"
                                              Width="200"
                                              VerticalAlignment="Center"
                                              SelectedIndex="0"
                                              SelectionChanged="PollIntervalComboBox_SelectionChanged">
                                        <ComboBoxItem Content="100 ms" Tag="100"/>
                                        <ComboBoxItem Content="200 ms" Tag="200"/>
                                        <ComboBoxItem Content="500 ms" Tag="500"/>
                                        <ComboBoxItem Content="1 s" Tag="1000"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- 以太网专属选项 -->
                                <StackPanel x:Name="EthernetOptionsPanel">

                                    <!-- 目标网卡 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="目标网卡"
                                                   Width="80"
                                                   FontSize="14" Foreground="#1A1A1A"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox x:Name="TargetNicComboBox"
                                                  Width="200"
                                                  VerticalAlignment="Center"/>
                                        <Button x:Name="RefreshNicButton"
                                                Content="刷新"
                                                Width="60" Height="{Binding ActualHeight, ElementName=TargetNicComboBox}"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                Click="RefreshNicButton_Click"/>
                                    </StackPanel>

                                    <!-- IP -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="IP地址
                                                   "
                                                   Width="80"
                                                   FontSize="14" Foreground="#1A1A1A"
                                                   VerticalAlignment="Center"/>
                                        <TextBox x:Name="IpTextBox"
                                                 Width="200"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Padding="8,0"
                                                 FontSize="13"
                                                 Text="192.168.1.100"
                                                 TextChanged="ConfigInput_TextChanged"/>
                                        <Button x:Name="ConnectButton"
                                                Content="连接"
                                                Width="60"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                Click="ConnectButton_Click"/>
                                    </StackPanel>

                                    <!-- 端口号 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="端口号"
                                                   Width="80"
                                                   FontSize="14" Foreground="#1A1A1A"
                                                   VerticalAlignment="Center"/>
                                        <TextBox x:Name="PortTextBox"
                                                 Width="200"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Padding="8,0"
                                                 FontSize="13"
                                                 Text="502"
                                                 TextChanged="ConfigInput_TextChanged"/>
                                    </StackPanel>

                                </StackPanel>

                                <!-- 分隔线：连接参数与地址表元件（上方 16 由末行表单提供，上下对称；串口模式下末行为采集周期，同样成立） -->
                                <Border Height="1" Background="#E8E8E8" Margin="0,0,0,16"/>

                                <!-- 地址区标题 -->
                                <TextBlock Text="设备通讯区域"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A"
                                           Margin="0,0,0,12"/>

                                <!-- ===== 设备通讯区域：左「字节顺序」 | 竖分隔线 | 右「地址表元件」 =====
                                     左右并排而非上下堆叠 —— 5 行压成 3 行，窗口最小（1024×640）时也能完整显示。
                                     两栏各自内部纵向排列；分隔线用 1px Border，随该行高度自然拉伸。 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ===== 左：字节顺序（数据解释方式，随设备类型切换默认值） =====
                                         仅对「寄存器（字）」类数据有意义；线圈/位无字节序。
                                         选项文案用 1-2-3-4 记号：1=最高字节 … 4=最低字节，
                                         名称即这 4 个字节在字节流里的排列顺序。
                                         字符串只管寄存器内 2 个字符的先后，不涉及字序。 -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="32位整数字节顺序"
                                                       Width="140"
                                                       FontSize="14" Foreground="#1A1A1A"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox x:Name="Int32OrderComboBox"
                                                      Width="200"
                                                      VerticalAlignment="Center"
                                                      ToolTip="32 位整数占 2 个连续寄存器。1=最高字节 … 4=最低字节；名称即 4 个字节在字节流里的顺序。信捷 XD 实测为 3412（低字在前）。"
                                                      SelectionChanged="ByteOrderComboBox_SelectionChanged">
                                                <ComboBoxItem Content="1234（大端，高字在前）"/>
                                                <ComboBoxItem Content="2143（字内字节交换，高字在前）"/>
                                                <ComboBoxItem Content="3412（字交换，低字在前）"/>
                                                <ComboBoxItem Content="4321（小端，低字在前）"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="32位浮点数字节顺序"
                                                       Width="140"
                                                       FontSize="14" Foreground="#1A1A1A"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox x:Name="FloatOrderComboBox"
                                                      Width="200"
                                                      VerticalAlignment="Center"
                                                      ToolTip="REAL 与 DINT 是同一个 32 位整数，只是解释方式不同，多数品牌两者字序相同。信捷 XD 实测为 3412。"
                                                      SelectionChanged="ByteOrderComboBox_SelectionChanged">
                                                <ComboBoxItem Content="1234（大端，高字在前）"/>
                                                <ComboBoxItem Content="2143（字内字节交换，高字在前）"/>
                                                <ComboBoxItem Content="3412（字交换，低字在前）"/>
                                                <ComboBoxItem Content="4321（小端，低字在前）"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="字符串字节顺序"
                                                       Width="140"
                                                       FontSize="14" Foreground="#1A1A1A"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox x:Name="StringOrderComboBox"
                                                      Width="200"
                                                      VerticalAlignment="Center"
                                                      ToolTip="每个寄存器存 2 个字符（1=第 1 个字符，2=第 2 个字符）。信捷 XD 实测为 12（第 1 个字符在高字节）。字符串只有字节先后，没有字序。"
                                                      SelectionChanged="ByteOrderComboBox_SelectionChanged">
                                                <ComboBoxItem Content="12（第 1 个字符在高字节）"/>
                                                <ComboBoxItem Content="21（第 1 个字符在低字节）"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ===== 中间：竖分隔线 ===== -->
                                    <Border Grid.Column="1"
                                            Width="1" Background="#E8E8E8"
                                            Margin="20,0,20,0"
                                            VerticalAlignment="Stretch"/>

                                    <!-- ===== 右：当前设备类型的 Modbus 地址表元件（悬停查看各段范围与点数） ===== -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="线圈区"
                                                       Width="80"
                                                       FontSize="14" Foreground="#1A1A1A"
                                                       VerticalAlignment="Center"/>
                                            <ItemsControl x:Name="CoilAreaItems"
                                                          Style="{StaticResource AreaItemsControlStyle}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="寄存器区"
                                                       Width="80"
                                                       FontSize="14" Foreground="#1A1A1A"
                                                       VerticalAlignment="Center"/>
                                            <ItemsControl x:Name="RegisterAreaItems"
                                                          Style="{StaticResource AreaItemsControlStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>            </ScrollViewer>

            <!-- ================= 底栏：全局连接状态（三个页面都可见） =================
                 实现方式：底部对齐 + 内容区下边距 30 让位 —— 不新增行、不改左侧导航列任何属性。
                 跨两列 + 左缩进 112，使底栏左端与内容区左边界对齐（导航列止于 112）；
                 栏内文字向底栏自身两侧对齐（内边距 16），不跟随日志卡片缩进 -->
            <Border Grid.ColumnSpan="2" Margin="112,0,0,0"
                    Height="30" VerticalAlignment="Bottom"
                    Background="#F0F0F0"
                    BorderBrush="#DCDCDC" BorderThickness="0,1,0,0">
                <Grid Margin="16,0,16,0">
                    <!-- 左：状态点 + 状态文字（含重连倒计时） -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot"
                                 Width="9" Height="9"
                                 Fill="#9A9A9A"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText"
                                   Text="未连接"
                                   FontSize="12"
                                   Foreground="#5D5D5D"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 右：连接参数（驱动 / 连接方式 / 协议 / IP:端口） -->
                    <TextBlock x:Name="StatusBarDetail"
                               FontSize="12"
                               Foreground="#6A6A6A"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
